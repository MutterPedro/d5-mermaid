exports[`examples render regression > dotnet-eshoponcontainers/aggregate-buyer.md > matches SVG snapshot 1`] = `"<text class="d5-title" x="469" y="24" text-anchor="middle" font-size="18" font-weight="bold" fill="#1e293b">Buyer Aggregate</text><g class="d5-aggregate"><rect x="30" y="70" width="878" height="434" rx="12" fill="#f8fafc" stroke="#94a3b8" stroke-width="2" stroke-dasharray="8 4"></rect><text x="46" y="94" font-size="14" font-weight="600" fill="#475569">Aggregate: Buyer</text></g><g class="d5-entity d5-aggregate-root"><rect x="58" y="134" width="822" height="58" rx="8" fill="#eff6ff" stroke="#3b82f6" stroke-width="3"></rect><text x="469" y="159" text-anchor="middle" font-size="15" font-weight="bold" fill="#1e293b">Buyer</text><text x="469" y="177" text-anchor="middle" font-size="10" font-style="italic" fill="#3b82f6">Aggregate Root</text></g><g class="d5-entity"><rect x="58" y="216" width="150" height="49" rx="6" fill="white" stroke="#3b82f6" stroke-width="2"></rect><text x="133" y="236.05" text-anchor="middle" font-size="13" font-weight="600" fill="#1e293b">Payment Method</text><text x="133" y="255.05" text-anchor="middle" font-size="10" font-style="italic" fill="#3b82f6">Entity</text></g><g class="d5-value-object"><rect x="226" y="216" width="150" height="49" rx="24.5" fill="white" stroke="#10b981" stroke-width="2"></rect><text x="301" y="236.05" text-anchor="middle" font-size="13" font-weight="600" fill="#1e293b">Buyer ID</text><text x="301" y="255.05" text-anchor="middle" font-size="10" font-style="italic" fill="#10b981">Value Object</text></g><g class="d5-value-object"><rect x="394" y="216" width="150" height="49" rx="24.5" fill="white" stroke="#10b981" stroke-width="2"></rect><text x="469" y="236.05" text-anchor="middle" font-size="13" font-weight="600" fill="#1e293b">Identity GUID</text><text x="469" y="255.05" text-anchor="middle" font-size="10" font-style="italic" fill="#10b981">Value Object</text></g><g class="d5-value-object"><rect x="562" y="216" width="150" height="49" rx="24.5" fill="white" stroke="#10b981" stroke-width="2"></rect><text x="637" y="236.05" text-anchor="middle" font-size="13" font-weight="600" fill="#1e293b">Card Type</text><text x="637" y="255.05" text-anchor="middle" font-size="10" font-style="italic" fill="#10b981">Value Object</text></g><g class="d5-value-object"><rect x="730" y="216" width="150" height="49" rx="24.5" fill="white" stroke="#10b981" stroke-width="2"></rect><text x="805" y="236.05" text-anchor="middle" font-size="13" font-weight="600" fill="#1e293b">Card Alias</text><text x="805" y="255.05" text-anchor="middle" font-size="10" font-style="italic" fill="#10b981">Value Object</text></g><g class="d5-value-object"><rect x="58" y="283" width="150" height="49" rx="24.5" fill="white" stroke="#10b981" stroke-width="2"></rect><text x="133" y="303.05" text-anchor="middle" font-size="13" font-weight="600" fill="#1e293b">Card Number</text><text x="133" y="322.05" text-anchor="middle" font-size="10" font-style="italic" fill="#10b981">Value Object</text></g><g class="d5-value-object"><rect x="226" y="283" width="150" height="49" rx="24.5" fill="white" stroke="#10b981" stroke-width="2"></rect><text x="301" y="303.05" text-anchor="middle" font-size="13" font-weight="600" fill="#1e293b">Expiration</text><text x="301" y="322.05" text-anchor="middle" font-size="10" font-style="italic" fill="#10b981">Value Object</text></g><g class="d5-invariants"><rect x="38" y="342" width="862" height="134" rx="6" fill="#fffbeb" stroke="#fcd34d" stroke-width="1" stroke-dasharray="4 3"></rect><text x="46" y="364.8" font-size="12" font-weight="bold" fill="#92400e">Invariants — enforced by root: Buyer</text><rect x="47" y="376" width="6" height="6" transform="rotate(45 50 379)" fill="#f59e0b"></rect><text x="62" y="382" font-size="12" fill="#78350f">A buyer is uniquely identified by their identity-service GUID</text><rect x="47" y="401" width="6" height="6" transform="rotate(45 50 404)" fill="#f59e0b"></rect><text x="62" y="407" font-size="12" fill="#78350f">A payment method is added only once — a card with the same number, expiry and card type is reused,</text><text x="62" y="423" font-size="12" fill="#78350f">not duplicated</text><rect x="47" y="442" width="6" height="6" transform="rotate(45 50 445)" fill="#f59e0b"></rect><text x="62" y="448" font-size="12" fill="#78350f">An order cannot be charged to a payment method whose expiration date has passed</text></g><g class="d5-legend"><rect x="30" y="520" width="14" height="14" rx="3" fill="white" stroke="#3b82f6" stroke-width="3"></rect><text x="50" y="531" font-size="11" fill="#64748b">Aggregate Root</text><rect x="156.43000000000004" y="520" width="14" height="14" rx="3" fill="white" stroke="#3b82f6" stroke-width="2"></rect><text x="176.43000000000004" y="531" font-size="11" fill="#64748b">Entity</text><rect x="234.35000000000002" y="520" width="14" height="14" rx="7" fill="white" stroke="#10b981" stroke-width="2"></rect><text x="254.35000000000002" y="531" font-size="11" fill="#64748b">Value Object</text></g>"`;

exports[`examples render regression > dotnet-eshoponcontainers/aggregate-catalog-item.md > matches SVG snapshot 1`] = `"<text class="d5-title" x="511.5" y="24" text-anchor="middle" font-size="18" font-weight="bold" fill="#1e293b">Catalog Item Aggregate</text><g class="d5-aggregate"><rect x="30" y="70" width="963" height="434" rx="12" fill="#f8fafc" stroke="#94a3b8" stroke-width="2" stroke-dasharray="8 4"></rect><text x="46" y="94" font-size="14" font-weight="600" fill="#475569">Aggregate: Catalog Item</text></g><g class="d5-entity d5-aggregate-root"><rect x="58" y="134" width="907" height="58" rx="8" fill="#eff6ff" stroke="#3b82f6" stroke-width="3"></rect><text x="511.5" y="159" text-anchor="middle" font-size="15" font-weight="bold" fill="#1e293b">Catalog Item</text><text x="511.5" y="177" text-anchor="middle" font-size="10" font-style="italic" fill="#3b82f6">Aggregate Root</text></g><g class="d5-value-object"><rect x="58" y="216" width="167" height="49" rx="24.5" fill="white" stroke="#10b981" stroke-width="2"></rect><text x="141.5" y="236.05" text-anchor="middle" font-size="13" font-weight="600" fill="#1e293b">Catalog Item ID</text><text x="141.5" y="255.05" text-anchor="middle" font-size="10" font-style="italic" fill="#10b981">Value Object</text></g><g class="d5-value-object"><rect x="243" y="216" width="167" height="49" rx="24.5" fill="white" stroke="#10b981" stroke-width="2"></rect><text x="326.5" y="236.05" text-anchor="middle" font-size="13" font-weight="600" fill="#1e293b">Name</text><text x="326.5" y="255.05" text-anchor="middle" font-size="10" font-style="italic" fill="#10b981">Value Object</text></g><g class="d5-value-object"><rect x="428" y="216" width="167" height="49" rx="24.5" fill="white" stroke="#10b981" stroke-width="2"></rect><text x="511.5" y="236.05" text-anchor="middle" font-size="13" font-weight="600" fill="#1e293b">Price</text><text x="511.5" y="255.05" text-anchor="middle" font-size="10" font-style="italic" fill="#10b981">Value Object</text></g><g class="d5-value-object"><rect x="613" y="216" width="167" height="49" rx="24.5" fill="white" stroke="#10b981" stroke-width="2"></rect><text x="696.5" y="236.05" text-anchor="middle" font-size="13" font-weight="600" fill="#1e293b">Available Stock</text><text x="696.5" y="255.05" text-anchor="middle" font-size="10" font-style="italic" fill="#10b981">Value Object</text></g><g class="d5-value-object"><rect x="798" y="216" width="167" height="49" rx="24.5" fill="white" stroke="#10b981" stroke-width="2"></rect><text x="881.5" y="236.05" text-anchor="middle" font-size="13" font-weight="600" fill="#1e293b">Restock Threshold</text><text x="881.5" y="255.05" text-anchor="middle" font-size="10" font-style="italic" fill="#10b981">Value Object</text></g><g class="d5-value-object"><rect x="58" y="283" width="167" height="49" rx="24.5" fill="white" stroke="#10b981" stroke-width="2"></rect><text x="141.5" y="303.05" text-anchor="middle" font-size="13" font-weight="600" fill="#1e293b">Max Stock Threshold</text><text x="141.5" y="322.05" text-anchor="middle" font-size="10" font-style="italic" fill="#10b981">Value Object</text></g><g class="d5-value-object"><rect x="243" y="283" width="167" height="49" rx="24.5" fill="white" stroke="#10b981" stroke-width="2"></rect><text x="326.5" y="303.05" text-anchor="middle" font-size="13" font-weight="600" fill="#1e293b">Catalog Brand</text><text x="326.5" y="322.05" text-anchor="middle" font-size="10" font-style="italic" fill="#10b981">Value Object</text></g><g class="d5-value-object"><rect x="428" y="283" width="167" height="49" rx="24.5" fill="white" stroke="#10b981" stroke-width="2"></rect><text x="511.5" y="303.05" text-anchor="middle" font-size="13" font-weight="600" fill="#1e293b">Catalog Type</text><text x="511.5" y="322.05" text-anchor="middle" font-size="10" font-style="italic" fill="#10b981">Value Object</text></g><g class="d5-invariants"><rect x="38" y="342" width="947" height="134" rx="6" fill="#fffbeb" stroke="#fcd34d" stroke-width="1" stroke-dasharray="4 3"></rect><text x="46" y="364.8" font-size="12" font-weight="bold" fill="#92400e">Invariants — enforced by root: Catalog Item</text><rect x="47" y="376" width="6" height="6" transform="rotate(45 50 379)" fill="#f59e0b"></rect><text x="62" y="382" font-size="12" fill="#78350f">Available stock never goes negative — an order removal larger than the stock on hand is clamped to</text><text x="62" y="398" font-size="12" fill="#78350f">what is available</text><rect x="47" y="417" width="6" height="6" transform="rotate(45 50 420)" fill="#f59e0b"></rect><text x="62" y="423" font-size="12" fill="#78350f">When available stock drops to or below the restock threshold, the item is flagged for reorder</text><rect x="47" y="442" width="6" height="6" transform="rotate(45 50 445)" fill="#f59e0b"></rect><text x="62" y="448" font-size="12" fill="#78350f">A restock never takes available stock above the max stock threshold</text></g><g class="d5-legend"><rect x="30" y="520" width="14" height="14" rx="3" fill="white" stroke="#3b82f6" stroke-width="3"></rect><text x="50" y="531" font-size="11" fill="#64748b">Aggregate Root</text><rect x="156.43000000000004" y="520" width="14" height="14" rx="3" fill="white" stroke="#3b82f6" stroke-width="2"></rect><text x="176.43000000000004" y="531" font-size="11" fill="#64748b">Entity</text><rect x="234.35000000000002" y="520" width="14" height="14" rx="7" fill="white" stroke="#10b981" stroke-width="2"></rect><text x="254.35000000000002" y="531" font-size="11" fill="#64748b">Value Object</text></g>"`;

exports[`examples render regression > dotnet-eshoponcontainers/aggregate-order.md > matches SVG snapshot 1`] = `"<text class="d5-title" x="481.5" y="24" text-anchor="middle" font-size="18" font-weight="bold" fill="#1e293b">Order Aggregate</text><g class="d5-aggregate"><rect x="30" y="70" width="903" height="516" rx="12" fill="#f8fafc" stroke="#94a3b8" stroke-width="2" stroke-dasharray="8 4"></rect><text x="46" y="94" font-size="14" font-weight="600" fill="#475569">Aggregate: Order</text></g><g class="d5-entity d5-aggregate-root"><rect x="58" y="134" width="847" height="58" rx="8" fill="#eff6ff" stroke="#3b82f6" stroke-width="3"></rect><text x="481.5" y="159" text-anchor="middle" font-size="15" font-weight="bold" fill="#1e293b">Order</text><text x="481.5" y="177" text-anchor="middle" font-size="10" font-style="italic" fill="#3b82f6">Aggregate Root</text></g><g class="d5-entity"><rect x="58" y="216" width="155" height="49" rx="6" fill="white" stroke="#3b82f6" stroke-width="2"></rect><text x="135.5" y="236.05" text-anchor="middle" font-size="13" font-weight="600" fill="#1e293b">Order Item</text><text x="135.5" y="255.05" text-anchor="middle" font-size="10" font-style="italic" fill="#3b82f6">Entity</text></g><g class="d5-value-object"><rect x="231" y="216" width="155" height="49" rx="24.5" fill="white" stroke="#10b981" stroke-width="2"></rect><text x="308.5" y="236.05" text-anchor="middle" font-size="13" font-weight="600" fill="#1e293b">Order ID</text><text x="308.5" y="255.05" text-anchor="middle" font-size="10" font-style="italic" fill="#10b981">Value Object</text></g><g class="d5-value-object"><rect x="404" y="216" width="155" height="49" rx="24.5" fill="white" stroke="#10b981" stroke-width="2"></rect><text x="481.5" y="236.05" text-anchor="middle" font-size="13" font-weight="600" fill="#1e293b">Address</text><text x="481.5" y="255.05" text-anchor="middle" font-size="10" font-style="italic" fill="#10b981">Value Object</text></g><g class="d5-value-object"><rect x="577" y="216" width="155" height="49" rx="24.5" fill="white" stroke="#10b981" stroke-width="2"></rect><text x="654.5" y="236.05" text-anchor="middle" font-size="13" font-weight="600" fill="#1e293b">Order Status</text><text x="654.5" y="255.05" text-anchor="middle" font-size="10" font-style="italic" fill="#10b981">Value Object</text></g><g class="d5-value-object"><rect x="750" y="216" width="155" height="49" rx="24.5" fill="white" stroke="#10b981" stroke-width="2"></rect><text x="827.5" y="236.05" text-anchor="middle" font-size="13" font-weight="600" fill="#1e293b">Buyer ID</text><text x="827.5" y="255.05" text-anchor="middle" font-size="10" font-style="italic" fill="#10b981">Value Object</text></g><g class="d5-value-object"><rect x="58" y="283" width="155" height="49" rx="24.5" fill="white" stroke="#10b981" stroke-width="2"></rect><text x="135.5" y="303.05" text-anchor="middle" font-size="13" font-weight="600" fill="#1e293b">Payment Method ID</text><text x="135.5" y="322.05" text-anchor="middle" font-size="10" font-style="italic" fill="#10b981">Value Object</text></g><g class="d5-value-object"><rect x="231" y="283" width="155" height="49" rx="24.5" fill="white" stroke="#10b981" stroke-width="2"></rect><text x="308.5" y="303.05" text-anchor="middle" font-size="13" font-weight="600" fill="#1e293b">Unit Price</text><text x="308.5" y="322.05" text-anchor="middle" font-size="10" font-style="italic" fill="#10b981">Value Object</text></g><g class="d5-value-object"><rect x="404" y="283" width="155" height="49" rx="24.5" fill="white" stroke="#10b981" stroke-width="2"></rect><text x="481.5" y="303.05" text-anchor="middle" font-size="13" font-weight="600" fill="#1e293b">Discount</text><text x="481.5" y="322.05" text-anchor="middle" font-size="10" font-style="italic" fill="#10b981">Value Object</text></g><g class="d5-invariants"><rect x="38" y="342" width="887" height="216" rx="6" fill="#fffbeb" stroke="#fcd34d" stroke-width="1" stroke-dasharray="4 3"></rect><text x="46" y="364.8" font-size="12" font-weight="bold" fill="#92400e">Invariants — enforced by root: Order</text><rect x="47" y="376" width="6" height="6" transform="rotate(45 50 379)" fill="#f59e0b"></rect><text x="62" y="382" font-size="12" fill="#78350f">An order always has at least one order item</text><rect x="47" y="401" width="6" height="6" transform="rotate(45 50 404)" fill="#f59e0b"></rect><text x="62" y="407" font-size="12" fill="#78350f">Status — Status only advances Submitted → AwaitingValidation → StockConfirmed → Paid → Shipped; it</text><text x="62" y="423" font-size="12" fill="#78350f">may be Cancelled only from a non-final status</text><rect x="47" y="442" width="6" height="6" transform="rotate(45 50 445)" fill="#f59e0b"></rect><text x="62" y="448" font-size="12" fill="#78350f">An order item's unit price is captured when the order is placed and is never re-read from the catalog</text><text x="62" y="464" font-size="12" fill="#78350f">afterwards</text><rect x="47" y="483" width="6" height="6" transform="rotate(45 50 486)" fill="#f59e0b"></rect><text x="62" y="489" font-size="12" fill="#78350f">Adding a product already on the order merges into its existing item — quantities sum and the higher</text><text x="62" y="505" font-size="12" fill="#78350f">discount wins</text><rect x="47" y="524" width="6" height="6" transform="rotate(45 50 527)" fill="#f59e0b"></rect><text x="62" y="530" font-size="12" fill="#78350f">The order total is the sum over items of (unit price − discount) × units</text></g><g class="d5-legend"><rect x="30" y="602" width="14" height="14" rx="3" fill="white" stroke="#3b82f6" stroke-width="3"></rect><text x="50" y="613" font-size="11" fill="#64748b">Aggregate Root</text><rect x="156.43000000000004" y="602" width="14" height="14" rx="3" fill="white" stroke="#3b82f6" stroke-width="2"></rect><text x="176.43000000000004" y="613" font-size="11" fill="#64748b">Entity</text><rect x="234.35000000000002" y="602" width="14" height="14" rx="7" fill="white" stroke="#10b981" stroke-width="2"></rect><text x="254.35000000000002" y="613" font-size="11" fill="#64748b">Value Object</text></g>"`;

exports[`examples render regression > dotnet-eshoponcontainers/context-ordering.md > matches SVG snapshot 1`] = `"<defs><marker id="d5-arrowhead" markerWidth="8" markerHeight="8" refX="8" refY="4" orient="auto"><path d="M0,0 L8,4 L0,8" fill="#64748b"></path></marker><marker id="d5-event-arrowhead" markerWidth="8" markerHeight="8" refX="8" refY="4" orient="auto"><path d="M0,0 L8,4 L0,8" fill="#d97706"></path></marker><marker id="d5-policy-arrowhead" markerWidth="8" markerHeight="8" refX="8" refY="4" orient="auto"><path d="M0,0 L8,4 L0,8" fill="#7c3aed"></path></marker></defs><text class="d5-title" x="563" y="24" text-anchor="middle" font-size="18" font-weight="bold" fill="#1e293b">Ordering Context — Tactical Structure</text><g class="d5-bounded-context"><rect x="30" y="64" width="1066" height="532" rx="12" fill="#f8fafc" stroke="#94a3b8" stroke-width="2" stroke-dasharray="8 4"></rect><text x="46" y="88" font-size="14" font-weight="600" fill="#475569">Ordering</text><text x="1080" y="88" font-size="12" font-style="italic" fill="#64748b" text-anchor="end">Team: Ordering Team</text></g><g class="d5-language-note"><rect x="738" y="130" width="328" height="436" rx="4" fill="#fef9c3" stroke="#ca8a04" stroke-width="1.5"></rect><path d="M738,160 L738,134 Q738,130 742,130 L1062,130 Q1066,130 1066,134 L1066,160 Z" fill="#fde047"></path><text x="902" y="150" text-anchor="middle" font-size="12" font-weight="bold" fill="#854d0e">Ubiquitous Language</text><text x="752" y="184.2" font-size="12" font-weight="bold" fill="#713f12">Order:</text><text x="752" y="202.2" font-size="11" fill="#854d0e">A customer's confirmed purchase — a set of order items</text><text x="752" y="216.2" font-size="11" fill="#854d0e">with a shipping address — moving through a fixed status</text><text x="752" y="230.2" font-size="11" fill="#854d0e">workflow</text><text x="752" y="256.2" font-size="12" font-weight="bold" fill="#713f12">Order Item:</text><text x="752" y="274.2" font-size="11" fill="#854d0e">One product line on an order: the product id, the unit price</text><text x="752" y="288.2" font-size="11" fill="#854d0e">captured at order time, the quantity and any discount</text><text x="752" y="314.2" font-size="12" font-weight="bold" fill="#713f12">Buyer:</text><text x="752" y="332.2" font-size="11" fill="#854d0e">The party placing orders, identified by their</text><text x="752" y="346.2" font-size="11" fill="#854d0e">identity-service GUID; owns the payment methods an</text><text x="752" y="360.2" font-size="11" fill="#854d0e">order can be charged against</text><text x="752" y="386.2" font-size="12" font-weight="bold" fill="#713f12">Payment Method:</text><text x="752" y="404.2" font-size="11" fill="#854d0e">A card a buyer has registered — alias, last digits, expiry</text><text x="752" y="418.2" font-size="11" fill="#854d0e">and card type — usable to pay an order</text><text x="752" y="444.2" font-size="12" font-weight="bold" fill="#713f12">Order Status:</text><text x="752" y="462.2" font-size="11" fill="#854d0e">Submitted → AwaitingValidation → StockConfirmed → Paid</text><text x="752" y="476.2" font-size="11" fill="#854d0e">→ Shipped; Cancelled is reachable from any non-final</text><text x="752" y="490.2" font-size="11" fill="#854d0e">status</text><text x="752" y="516.2" font-size="12" font-weight="bold" fill="#713f12">Card Type:</text><text x="752" y="534.2" font-size="11" fill="#854d0e">The scheme of a payment method: Amex, Visa or</text><text x="752" y="548.2" font-size="11" fill="#854d0e">MasterCard</text></g><g class="d5-aggregate"><rect x="60" y="183.75" width="180" height="186" rx="8" fill="white" stroke="#3b82f6" stroke-width="2"></rect><path d="M60,217.75 L60,191.75 Q60,183.75 68,183.75 L232,183.75 Q240,183.75 240,191.75 L240,217.75 Z" fill="#dbeafe"></path><line x1="60" y1="217.75" x2="240" y2="217.75" stroke="#3b82f6" stroke-width="1.5"></line><text x="150" y="203.75" text-anchor="middle" font-size="13" font-weight="bold" fill="#1e293b">Order</text><tex