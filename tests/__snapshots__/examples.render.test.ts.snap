ll="#1e293b">Order Status</text><text x="637" y="322.05" text-anchor="middle" font-size="10" font-style="italic" fill="#10b981">Value Object</text></g><g class="d5-invariants"><rect x="38" y="342" width="862" height="200" rx="6" fill="#fffbeb" stroke="#fcd34d" stroke-width="1" stroke-dasharray="4 3"></rect><text x="46" y="364.8" font-size="12" font-weight="bold" fill="#92400e">Invariants — enforced by root: Order</text><rect x="47" y="376" width="6" height="6" transform="rotate(45 50 379)" fill="#f59e0b"></rect><text x="62" y="382" font-size="12" fill="#78350f">An order has at least one order line</text><rect x="47" y="401" width="6" height="6" transform="rotate(45 50 404)" fill="#f59e0b"></rect><text x="62" y="407" font-size="12" fill="#78350f">Product name and unit price are copied from the catalog at checkout and never re-read afterwards</text><rect x="47" y="426" width="6" height="6" transform="rotate(45 50 429)" fill="#f59e0b"></rect><text x="62" y="432" font-size="12" fill="#78350f">The shipping address is copied from the customer record at checkout, so a later address change does</text><text x="62" y="448" font-size="12" fill="#78350f">not move existing orders</text><rect x="47" y="467" width="6" height="6" transform="rotate(45 50 470)" fill="#f59e0b"></rect><text x="62" y="473" font-size="12" fill="#78350f">Status — Open → Placed → Completed; the order is published to delivery and billing only once it is</text><text x="62" y="489" font-size="12" fill="#78350f">Placed</text><rect x="47" y="508" width="6" height="6" transform="rotate(45 50 511)" fill="#f59e0b"></rect><text x="62" y="514" font-size="12" fill="#78350f">The order total is the sum of quantity × unit price over all lines</text></g><g class="d5-legend"><rect x="30" y="586" width="14" height="14" rx="3" fill="white" stroke="#3b82f6" stroke-width="3"></rect><text x="50" y="597" font-size="11" fill="#64748b">Aggregate Root</text><rect x="156.43000000000004" y="586" width="14" height="14" rx="3" fill="white" stroke="#3b82f6" stroke-width="2"></rect><text x="176.43000000000004" y="597" font-size="11" fill="#64748b">Entity</text><rect x="234.35000000000002" y="586" width="14" height="14" rx="7" fill="white" stroke="#10b981" stroke-width="2"></rect><text x="254.35000000000002" y="597" font-size="11" fill="#64748b">Value Object</text></g>"`;

exports[`examples render regression > wolff-microservices/context-order.md > matches SVG snapshot 1`] = `"<defs><marker id="d5-arrowhead" markerWidth="8" markerHeight="8" refX="8" refY="4" orient="auto"><path d="M0,0 L8,4 L0,8" fill="#64748b"></path></marker><marker id="d5-event-arrowhead" markerWidth="8" markerHeight="8" refX="8" refY="4" orient="auto"><path d="M0,0 L8,4 L0,8" fill="#d97706"></path></marker><marker id="d5-policy-arrowhead" markerWidth="8" markerHeight="8" refX="8" refY="4" orient="auto"><path d="M0,0 L8,4 L0,8" fill="#7c3aed"></path></marker></defs><text class="d5-title" x="711" y="24" text-anchor="middle" font-size="18" font-weight="bold" fill="#1e293b">Order Context — Tactical Structure</text><g class="d5-bounded-context"><rect x="30" y="64" width="1362" height="402" rx="12" fill="#f8fafc" stroke="#94a3b8" stroke-width="2" stroke-dasharray="8 4"></rect><text x="46" y="88" font-size="14" font-weight="600" fill="#475569">Order</text><text x="1376" y="88" font-size="12" font-style="italic" fill="#64748b" text-anchor="end">Team: Order Team</text></g><g class="d5-language-note"><rect x="1034" y="130" width="328" height="306" rx="4" fill="#fef9c3" stroke="#ca8a04" stroke-width="1.5"></rect><path d="M1034,160 L1034,134 Q1034,130 1038,130 L1358,130 Q1362,130 1362,134 L1362,160 Z" fill="#fde047"></path><text x="1198" y="150" text-anchor="middle" font-size="12" font-weight="bold" fill="#854d0e">Ubiquitous Language</text><text x="1048" y="184.2" font-size="12" font-weight="bold" fill="#713f12">Basket:</text><text x="1048" y="202.2" font-size="11" fill="#854d0e">A customer's working set of items before checkout —</text><text x="1048" y="216.2" font-size="11" fill="#854d0e">quantities can still change and prices are shown live from</text><text x="1048" y="230.2" font-size="11" fill="#854d0e">the catalog</text><text x="1048" y="256.2" font-size="12" font-weight="bold" fill="#713f12">Order:</text><text x="1048" y="274.2" font-size="11" fill="#854d0e">A basket that has been checked out: its lines now carry</text><text x="1048" y="288.2" font-size="11" fill="#854d0e">copied product names and prices that will never change</text><text x="1048" y="302.2" font-size="11" fill="#854d0e">again</text><text x="1048" y="328.2" font-size="12" font-weight="bold" fill="#713f12">Order Line:</text><text x="1048" y="346.2" font-size="11" fill="#854d0e">One product on an order — product id, the product name</text><text x="1048" y="360.2" font-size="11" fill="#854d0e">and unit price copied at checkout, and a quantity</text><text x="1048" y="386.2" font-size="12" font-weight="bold" fill="#713f12">Order Status:</text><text x="1048" y="404.2" font-size="11" fill="#854d0e">Open → Placed → Completed; an order is published to</text><text x="1048" y="418.2" font-size="11" fill="#854d0e">delivery and billing only once it is Placed</text></g><g class="d5-aggregate"><rect x="60" y="229.25" width="180" height="126" rx="8" fill="white" stroke="#3b82f6" stroke-width="2"></rect><path d="M60,263.25 L60,237.25 Q60,229.25 68,229.25 L232,229.25 Q240,229.25 240,237.25 L240,263.25 Z" fill="#dbeafe"></path><line x1="60" y1="263.25" x2="240" y2="263.25" stroke="#3b82f6" stroke-width="1.5"></line><text x="150" y="249.25" text-anchor="middle" font-size="13" font-weight="bold" fill="#1e293b">Shopping Basket</text><text x="150" y="283.25" text-anchor="middle" font-size="11" font-style="italic" fill="#3b82f6">Root: Basket</text><line x1="70" y1="295.25" x2="230" y2="295.25" stroke="#cbd5e1" stroke-dasharray="4 4"></line><circle cx="80" cy="309.25" r="3" fill="#94a3b8"></circle><text x="90" y="313.25" font-size="12" fill="#475569">Customer</text><circle cx="80" cy="329.25" r="3" fill="#94a3b8"></circle><text x="90" y="333.25" font-size="12" fill="#475569">Basket Items</text></g><g class="d5-aggregate"><rect x="468" y="209.25" width="180" height="166" rx="8" fill="white" stroke="#3b82f6" stroke-width="2"></rect><path d="M468,243.25 L468,217.25 Q468,209.25 476,209.25 L640,209.25 Q648,209.25 648,217.25 L648,243.25 Z" fill="#dbeafe"></path><line x1="468" y1="243.25" x2="648" y2="243.25" stroke="#3b82f6" stroke-width="1.5"></line><text x="558" y="229.25" text-anchor="middle" font-size="13" font-weight="bold" fill="#1e293b">Order</text><text x="558" y="263.25" text-anchor="middle" font-size="11" font-style="italic" fill="#3b82f6">Root: Order</text><line x1="478" y1="275.25" x2="638" y2="275.25" stroke="#cbd5e1" stroke-dasharray="4 4"></line><circle cx="488" cy="289.25" r="3" fill="#94a3b8"></circle><text x="498" y="293.25" font-size="12" fill="#475569">Customer</text><circle cx="488" cy="309.25" r="3" fill="#94a3b8"></circle><text x="498" y="313.25" font-size="12" fill="#475569">Order Lines</text><circle cx="488" cy="329.25" r="3" fill="#94a3b8"></circle><text x="498" y="333.25" font-size="12" fill="#475569">Total</text><circle cx="488" cy="349.25" r="3" fill="#94a3b8"></circle><text x="498" y="353.25" font-size="12" fill="#475569">Status</text></g><g class="d5-read-model"><rect x="794" y="255.25" width="180" height="74" rx="6" fill="white" stroke="#64748b" stroke-width="2"></rect><path d="M794,285.25 L794,261.25 Q794,255.25 800,255.25 L968,255.25 Q974,255.25 974,261.25 L974,285.25 Z" fill="#f1f5f9"></path><line x1="794" y1="285.25" x2="974" y2="285.25" stroke="#64748b" stroke-width="1"></line><text x="884" y="274.25" text-anchor="middle" font-size="13" font-weight="bold" fill="#1e293b">Order Overview</text><text x="884" y="301.25" text-anchor="middle" font-size="10" font-style="italic" fill="#64748b">read model</text><line x1="806" y1="315.25" x2="962" y2="315.25" stroke="#e2e8f0" stroke-width="1"></line><line x1="806" y1="324.25" x2="962" y2="324.25" stroke="#e2e8f0" stroke-width="1"></line></g><g class="d5-rel"><path d="M 468 257.3970588235294 Q 354 213.25 297 235.3235294117647 L 240 257.3970588235294" fill="none" stroke="#64748b" stroke-width="1.5" marker-end="url(#d5-arrowhead)"></path><g class="d5-edge-label"><rect x="278" y="190.75" width="152" height="45" rx="4" fill="white" fill-opacity="0.92" stroke="#cbd5e1" stroke-width="1"></rect><text x="354" y="201.95" text-anchor="middle" font-size="10" font-weight="600" fill="#475569">an order is built from the</text><text x="354" y="214.95" text-anchor="middle" font-size="10" font-weight="600" fill="#475569">customer's basket, which is</text><text x="354" y="227.95" text-anchor="middle" font-size="10" font-weight="600" fill="#475569">then cleared</text></g></g><g class="d5-event"><title>BasketCheckedOut — emitted by basket_agg, handled by order_agg</title><path d="M 240 321.5882352941177 Q 354 358.75 411 340.16911764705884 L 468 321.5882352941177" fill="none" stroke="#d97706" stroke-width="1.5" stroke-dasharray="6 4" marker-end="url(#d5-event-arrowhead)"></path><g class="d5-event-label"><path d="M297.5,349.75 L403.5,349.75 L410.5,358.75 L403.5,367.75 L297.5,367.75 Z" fill="#fef3c7" stroke="#d97706" stroke-width="1"></path><text x="350.5" y="362.25" text-anchor="middle" font-size="10" font-weight="600" fill="#92400e">BasketCheckedOut</text></g></g><g class="d5-event"><title>OrderPlaced — emitted by order_agg, handled by order_overview</title><path d="M 648 292.25 Q 721 292.25 757.5 292.25 L 794 292.25" fill="none" stroke="#d97706" stroke-width="1.5" stroke-dasharray="6 4" marker-end="url(#d5-event-arrowhead)"></path><g class="d5-event-label"><path d="M678,283.25 L757,283.25 L764,292.25 L757,301.25 L678,301.25 Z" fill="#fef3c7" stroke="#d97706" stroke-width="1"></path><text x="717.5" y="295.75" text-anchor="middle" font-size="10" font-weight="600" fill="#92400e">OrderPlaced</text></g></g><g class="d5-policy"><title>Policy — triggered via basket_agg, acts on order_agg</title><path d="M 240 292.25 Q 354 292.25 411 292.25 L 468 292.25" fill="none" stroke="#7c3aed" stroke-width="1.5" stroke-dasharray="3 3" marker-end="url(#d5-policy-arrowhead)"></path><g class="d5-policy-label"><rect x="270" y="255.75" width="168" height="73" rx="4" fill="#ede9fe" stroke="#7c3aed" stroke-width="1"></rect><text x="354" y="267.95" text-anchor="middle" font-size="10" font-weight="600" fill="#5b21b6">when a basket is checked out,</text><text x="354" y="280.95" text-anchor="middle" font-size="10" font-weight="600" fill="#5b21b6">create an order from it,</text><text x="354" y="293.95" text-anchor="middle" font-size="10" font-weight="600" fill="#5b21b6">copying current catalog prices</text><text x="354" y="306.95" text-anchor="middle" font-size="10" font-weight="600" fill="#5b21b6">and the customer's shipping</text><text x="354" y="319.95" text-anchor="middle" font-size="10" font-weight="600" fill="#5b21b6">address</text></g></g>"`;

exports[`examples render regression > wolff-microservices/domain.md > matches SVG snapshot 1`] = `"<defs><marker id="d5-arrowhead" markerWidth="8" markerHeight="8" refX="8" refY="4" orient="auto"><path d="M0,0 L8,4 L0,8" fill="#64748b"></path></marker></defs><text class="d5-title" x="570.5" y="24" text-anchor="middle" font-size="18" font-weight="bold" fill="#1e293b">Webshop — Domain</text><g class="d5-domain"><rect x="30" y="70" width="1081" height="298" rx="12" fill="#f8fafc" stroke="#94a3b8" stroke-width="2" stroke-dasharray="8 4"></rect><text x="46" y="94" font-size="14" font-weight="600" fill="#475569">Webshop</text></g><g class="d5-subdomain d5-subdomain-core"><rect x="468" y="238" width="180" height="70" rx="8" fill="#dbeafe" stroke="#3b82f6" stroke-width="2"></rect><text x="558" y="269" text-anchor="middle" font-size="13" font-weight="600" fill="#1e293b">Order Process</text><text x="558" y="289" text-anchor="middle" font-size="11" fill="#3b82f6">core</text></g><g class="d5-subdomain d5-subdomain-supporting"><rect x="900.5" y="268" width="180" height="70" rx="8" fill="#fef9c3" stroke="#ca8a04" stroke-width="2"></rect><text x="990.5" y="299" text-anchor="middle" font-size="13" font-weight="600" fill="#1e293b">Product Catalog</text><text x="990.5" y="319" text-anchor="middle" font-size="11" fill="#ca8a04">supporting</text></g><g class="d5-subdomain d5-subdomain-supporting"><rect x="900" y="139.25" width="181" height="70" rx="8" fill="#fef9c3" stroke="#ca8a04" stroke-width="2"></rect><text x="990.5" y="170.25" text-anchor="middle" font-size="13" font-weight="600" fill="#1e293b">Customer Management</text><text x="990.5" y="190.25" text-anchor="middle" font-size="11" fill="#ca8a04">supporting</text></g><g class="d5-subdomain d5-subdomain-supporting"><rect x="60" y="261.5" width="180" height="70" rx="8" fill="#fef9c3" stroke="#ca8a04" stroke-width="2"></rect><text x="150" y="292.5" text-anchor="middle" font-size="13" font-weight="600" fill="#1e293b">Delivery</text><