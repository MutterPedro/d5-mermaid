562" y="216" width="150" height="49" rx="24.5" fill="white" stroke="#10b981" stroke-width="2"></rect><text x="637" y="236.05" text-anchor="middle" font-size="13" font-weight="600" fill="#1e293b">Used Limit</text><text x="637" y="255.05" text-anchor="middle" font-size="10" font-style="italic" fill="#10b981">Value Object</text></g><g class="d5-value-object"><rect x="730" y="216" width="150" height="49" rx="24.5" fill="white" stroke="#10b981" stroke-width="2"></rect><text x="805" y="236.05" text-anchor="middle" font-size="13" font-weight="600" fill="#1e293b">Available Limit</text><text x="805" y="255.05" text-anchor="middle" font-size="10" font-style="italic" fill="#10b981">Value Object</text></g><g class="d5-value-object"><rect x="58" y="283" width="150" height="49" rx="24.5" fill="white" stroke="#10b981" stroke-width="2"></rect><text x="133" y="303.05" text-anchor="middle" font-size="13" font-weight="600" fill="#1e293b">Billing Cycle</text><text x="133" y="322.05" text-anchor="middle" font-size="10" font-style="italic" fill="#10b981">Value Object</text></g><g class="d5-value-object"><rect x="226" y="283" width="150" height="49" rx="24.5" fill="white" stroke="#10b981" stroke-width="2"></rect><text x="301" y="303.05" text-anchor="middle" font-size="13" font-weight="600" fill="#1e293b">Amount</text><text x="301" y="322.05" text-anchor="middle" font-size="10" font-style="italic" fill="#10b981">Value Object</text></g><g class="d5-invariants"><rect x="38" y="342" width="862" height="159" rx="6" fill="#fffbeb" stroke="#fcd34d" stroke-width="1" stroke-dasharray="4 3"></rect><text x="46" y="364.8" font-size="12" font-weight="bold" fill="#92400e">Invariants — enforced by root: Credit Card</text><rect x="47" y="376" width="6" height="6" transform="rotate(45 50 379)" fill="#f59e0b"></rect><text x="62" y="382" font-size="12" fill="#78350f">The credit limit is assigned exactly once — a second assignment is rejected</text><rect x="47" y="401" width="6" height="6" transform="rotate(45 50 404)" fill="#f59e0b"></rect><text x="62" y="407" font-size="12" fill="#78350f">A withdrawal is permitted only while its amount is within the available limit (assigned limit − used</text><text x="62" y="423" font-size="12" fill="#78350f">limit)</text><rect x="47" y="442" width="6" height="6" transform="rotate(45 50 445)" fill="#f59e0b"></rect><text x="62" y="448" font-size="12" fill="#78350f">At most 45 withdrawals are permitted within a single billing cycle</text><rect x="47" y="467" width="6" height="6" transform="rotate(45 50 470)" fill="#f59e0b"></rect><text x="62" y="473" font-size="12" fill="#78350f">A repayment decreases the used limit but never takes it below zero</text></g><g class="d5-legend"><rect x="30" y="545" width="14" height="14" rx="3" fill="white" stroke="#3b82f6" stroke-width="3"></rect><text x="50" y="556" font-size="11" fill="#64748b">Aggregate Root</text><rect x="156.43000000000004" y="545" width="14" height="14" rx="3" fill="white" stroke="#3b82f6" stroke-width="2"></rect><text x="176.43000000000004" y="556" font-size="11" fill="#64748b">Entity</text><rect x="234.35000000000002" y="545" width="14" height="14" rx="7" fill="white" stroke="#10b981" stroke-width="2"></rect><text x="254.35000000000002" y="556" font-size="11" fill="#64748b">Value Object</text></g>"`;

exports[`examples render regression > all-things-cqrs/context-credit-card.md > matches SVG snapshot 1`] = `"<defs><marker id="d5-arrowhead" markerWidth="8" markerHeight="8" refX="8" refY="4" orient="auto"><path d="M0,0 L8,4 L0,8" fill="#64748b"></path></marker><marker id="d5-event-arrowhead" markerWidth="8" markerHeight="8" refX="8" refY="4" orient="auto"><path d="M0,0 L8,4 L0,8" fill="#d97706"></path></marker><marker id="d5-policy-arrowhead" markerWidth="8" markerHeight="8" refX="8" refY="4" orient="auto"><path d="M0,0 L8,4 L0,8" fill="#7c3aed"></path></marker></defs><text class="d5-title" x="548" y="24" text-anchor="middle" font-size="18" font-weight="bold" fill="#1e293b">Credit Card Context — Tactical Structure</text><g class="d5-bounded-context"><rect x="30" y="64" width="1036" height="518" rx="12" fill="#f8fafc" stroke="#94a3b8" stroke-width="2" stroke-dasharray="8 4"></rect><text x="46" y="88" font-size="14" font-weight="600" fill="#475569">Credit Card</text><text x="1050" y="88" font-size="12" font-style="italic" fill="#64748b" text-anchor="end">Team: Card Team</text></g><g class="d5-language-note"><rect x="708" y="130" width="328" height="422" rx="4" fill="#fef9c3" stroke="#ca8a04" stroke-width="1.5"></rect><path d="M708,160 L708,134 Q708,130 712,130 L1032,130 Q1036,130 1036,134 L1036,160 Z" fill="#fde047"></path><text x="872" y="150" text-anchor="middle" font-size="12" font-weight="bold" fill="#854d0e">Ubiquitous Language</text><text x="722" y="184.2" font-size="12" font-weight="bold" fill="#713f12">Credit Card:</text><text x="722" y="202.2" font-size="11" fill="#854d0e">A card with a one-time assigned credit limit that</text><text x="722" y="216.2" font-size="11" fill="#854d0e">withdrawals are drawn against and repayments credited</text><text x="722" y="230.2" font-size="11" fill="#854d0e">back to</text><text x="722" y="256.2" font-size="12" font-weight="bold" fill="#713f12">Assigned Limit:</text><text x="722" y="274.2" font-size="11" fill="#854d0e">The credit limit set once when the card is opened; it</text><text x="722" y="288.2" font-size="11" fill="#854d0e">never changes afterwards</text><text x="722" y="314.2" font-size="12" font-weight="bold" fill="#713f12">Available Limit:</text><text x="722" y="332.2" font-size="11" fill="#854d0e">The assigned limit minus the currently used limit — the</text><text x="722" y="346.2" font-size="11" fill="#854d0e">most that can still be withdrawn</text><text x="722" y="372.2" font-size="12" font-weight="bold" fill="#713f12">Withdrawal:</text><text x="722" y="390.2" font-size="11" fill="#854d0e">A draw-down against the available limit; each one</text><text x="722" y="404.2" font-size="11" fill="#854d0e">increases the used limit and is counted towards the cycle</text><text x="722" y="418.2" font-size="11" fill="#854d0e">quota</text><text x="722" y="444.2" font-size="12" font-weight="bold" fill="#713f12">Repayment:</text><text x="722" y="462.2" font-size="11" fill="#854d0e">A payment back onto the card that decreases the used</text><text x="722" y="476.2" font-size="11" fill="#854d0e">limit, never below zero</text><text x="722" y="502.2" font-size="12" font-weight="bold" fill="#713f12">Billing Cycle:</text><text x="722" y="520.2" font-size="11" fill="#854d0e">The window within which at most 45 withdrawals are</text><text x="722" y="534.2" font-size="11" fill="#854d0e">permitted; closing it resets the count</text></g><g class="d5-aggregate"><rect x="60" y="183.5" width="180" height="166" rx="8" fill="white" stroke="#3b82f6" stroke-width="2"></rect><path d="M60,217.5 L60,191.5 Q60,183.5 68,183.5 L232,183.5 Q240,183.5 240,191.5 L240,217.5 Z" fill="#dbeafe"></path><line x1="60" y1="217.5" x2="240" y2="217.5" stroke="#3b82f6" stroke-width="1.5"></line><text x="150" y="203.5" text-anchor="middle" font-size="13" font-weight="bold" fill="#1e293b">Credit Card</text><text x="150" y="237.5" text-anchor="middle" font-size="11" font-style="italic" fill="#3b82f6">Root: Credit Card</text><line x1="70" y1="249.5" x2="230" y2="249.5" stroke="#cbd5e1" stroke-dasharray="4 4"></line><circle cx="80" cy="263.5" r="3" fill="#94a3b8"></circle><text x="90" y="267.5" font-size="12" fill="#475569">Card ID</text><circle cx="80" cy="283.5" r="3" fill="#94a3b8"></circle><text x="90" y="287.5" font-size="12" fill="#475569">Assigned Limit</text><circle cx="80" cy="303.5" r="3" fill="#94a3b8"></circle><text x="90" y="307.5" font-size="12" fill="#475569">Used Limit</text><circle cx="80" cy="323.5" r="3" fill="#94a3b8"></circle><text x="90" y="327.5" font-size="12" fill="#475569">Withdrawals This Cycle</text></g><g class="d5-read-model"><rect x="468" y="249.5" width="180" height="74" rx="6" fill="white" stroke="#64748b" stroke-width="2"></rect><path d="M468,279.5 L468,255.5 Q468,249.5 474,249.5 L642,249.5 Q648,249.5 648,255.5 L648,279.5 Z" fill="#f1f5f9"></path><line x1="468" y1="279.5" x2="648" y2="279.5" stroke="#64748b" stroke-width="1"></line><text x="558" y="268.5" text-anchor="middle" font-size="13" font-weight="bold" fill="#1e293b">Withdrawals View</text><text x="558" y="295.5" text-anchor="middle" font-size="10" font-style="italic" fill="#64748b">read model</text><line x1="480" y1="309.5" x2="636" y2="309.5" stroke="#e2e8f0" stroke-width="1"></line><line x1="480" y1="318.5" x2="636" y2="318.5" stroke="#e2e8f0" stroke-width="1"></line></g><g class="d5-event"><title>LimitAssigned — emitted by card_agg, handled by withdrawals_view</title><path d="M 240 298.81617647058823 Q 354 339.75 411 324.87132352941177 L 468 309.99264705882354" fill="none" stroke="#d97706" stroke-width="1.5" stroke-dasharray="6 4" marker-end="url(#d5-event-arrowhead)"></path><g class="d5-event-label"><path d="M307,330.75 L394,330.75 L401,339.75 L394,348.75 L307,348.75 Z" fill="#fef3c7" stroke="#d97706" stroke-width="1"></path><text x="350.5" y="343.25" text-anchor="middle" font-size="10" font-weight="600" fill="#92400e">LimitAssigned</text></g></g><g class="d5-event"><title>CardWithdrawn — emitted by card_agg, handled by withdrawals_view</title><path d="M 240 281.16911764705884 Q 354 299.75 411 296.0477941176471 L 468 292.34558823529414" fill="none" stroke="#d97706" stroke-width="1.5" stroke-dasharray="6 4" marker-end="url(#d5-event-arrowhead)"></path><g class="d5-event-label"><path d="M304,290.75 L397,290.75 L404,299.75 L397,308.75 L304,308.75 Z" fill="#fef3c7" stroke="#d97706" stroke-width="1"></path><text x="350.5" y="303.25" text-anchor="middle" font-size="10" font-weight="600" fill="#92400e">CardWithdrawn</text></g></g><g class="d5-policy"><title>Policy — triggered via card_agg, acts on card_agg</title><path d="M 90.39893617021278 349.5 Q 60 391.83333333333337 60 397.125 Q 60 402.41666666666663 105 407.7083333333333 Q 150 413 195 407.7083333333333 Q 240 402.41666666666663 240 397.125 Q 240 391.83333333333337 224.8005319148936 370.6666666666667 L 209.60106382978722 349.5" fill="none" stroke="#7c3aed" stroke-width="1.5" stroke-dasharray="3 3" marker-end="url(#d5-policy-arrowhead)"></path><g class="d5-policy-label"><rect x="64.5" y="389.5" width="171" height="47" rx="4" fill="#ede9fe" stroke="#7c3aed" stroke-width="1"></rect><text x="150" y="401.7" text-anchor="middle" font-size="10" font-weight="600" fill="#5b21b6">when a billing cycle is closed,</text><text x="150" y="414.7" text-anchor="middle" font-size="10" font-weight="600" fill="#5b21b6">reset the withdrawal count and</text><text x="150" y="427.7" text-anchor="middle" font-size="10" font-weight="600" fill="#5b21b6">start the next cycle</text></g></g><g class="d5-policy"><title>Policy — triggered via card_agg, acts on withdrawals_view</title><path d="M 240 251.83088235294116 Q 354 233.25 411 248.12867647058823 L 468 263.00735294117646" fill="none" stroke="#7c3aed" stroke-width="1.5" stroke-dasharray="3 3" marker-end="url(#d5-policy-arrowhead)"></path><g class="d5-policy-label"><rect x="270" y="196.75" width="168" height="73" rx="4" fill="#ede9fe" stroke="#7c3aed" stroke-width="1"></rect><text x="354" y="208.95" text-anchor="middle" font-size="10" font-weight="600" fill="#5b21b6">on each CardWithdrawn event,</text><text x="354" y="221.95" text-anchor="middle" font-size="10" font-weight="600" fill="#5b21b6">append the amount to that</text><text x="354" y="234.95" text-anchor="middle" font-size="10" font-weight="600" fill="#5b21b6">card's withdrawals list</text><text x="354" y="247.95" text-anchor="middle" font-size="10" font-weight="600" fill="#5b21b6">(eventually consistent, via</text><text x="354" y="260.95" text-anchor="middle" font-size="10" font-weight="600" fill="#5b21b6">Kafka)</text></g></g>"`;

