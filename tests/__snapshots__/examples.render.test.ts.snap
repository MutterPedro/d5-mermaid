exports[`examples render regression > dddsample-core/aggregate-cargo.md > matches SVG snapshot 1`] = `"<text class="d5-title" x="427" y="24" text-anchor="middle" font-size="18" font-weight="bold" fill="#1e293b">Cargo Aggregate</text><g class="d5-aggregate"><rect x="30" y="70" width="794" height="634" rx="12" fill="#f8fafc" stroke="#94a3b8" stroke-width="2" stroke-dasharray="8 4"></rect><text x="46" y="94" font-size="14" font-weight="600" fill="#475569">Aggregate: Cargo</text></g><g class="d5-entity d5-aggregate-root"><rect x="58" y="134" width="738" height="58" rx="8" fill="#eff6ff" stroke="#3b82f6" stroke-width="3"></rect><text x="427" y="159" text-anchor="middle" font-size="15" font-weight="bold" fill="#1e293b">Cargo</text><text x="427" y="177" text-anchor="middle" font-size="10" font-style="italic" fill="#3b82f6">Aggregate Root</text></g><g class="d5-value-object"><rect x="58" y="216" width="234" height="49" rx="24.5" fill="white" stroke="#10b981" stroke-width="2"></rect><text x="175" y="236.05" text-anchor="middle" font-size="13" font-weight="600" fill="#1e293b">Tracking ID</text><text x="175" y="255.05" text-anchor="middle" font-size="10" font-style="italic" fill="#10b981">Value Object</text></g><g class="d5-value-object"><rect x="310" y="216" width="234" height="49" rx="24.5" fill="white" stroke="#10b981" stroke-width="2"></rect><text x="427" y="236.05" text-anchor="middle" font-size="13" font-weight="600" fill="#1e293b">Route Specification</text><text x="427" y="255.05" text-anchor="middle" font-size="10" font-style="italic" fill="#10b981">Value Object</text></g><g class="d5-value-object"><rect x="562" y="216" width="234" height="49" rx="24.5" fill="white" stroke="#10b981" stroke-width="2"></rect><text x="679" y="236.05" text-anchor="middle" font-size="13" font-weight="600" fill="#1e293b">Itinerary</text><text x="679" y="255.05" text-anchor="middle" font-size="10" font-style="italic" fill="#10b981">Value Object</text></g><g class="d5-value-object"><rect x="58" y="283" width="234" height="49" rx="24.5" fill="white" stroke="#10b981" stroke-width="2"></rect><text x="175" y="303.05" text-anchor="middle" font-size="13" font-weight="600" fill="#1e293b">Leg</text><text x="175" y="322.05" text-anchor="middle" font-size="10" font-style="italic" fill="#10b981">Value Object</text></g><g class="d5-value-object"><rect x="310" y="283" width="234" height="49" rx="24.5" fill="white" stroke="#10b981" stroke-width="2"></rect><text x="427" y="303.05" text-anchor="middle" font-size="13" font-weight="600" fill="#1e293b">Delivery</text><text x="427" y="322.05" text-anchor="middle" font-size="10" font-style="italic" fill="#10b981">Value Object</text></g><g class="d5-value-object"><rect x="562" y="283" width="234" height="49" rx="24.5" fill="white" stroke="#10b981" stroke-width="2"></rect><text x="679" y="303.05" text-anchor="middle" font-size="13" font-weight="600" fill="#1e293b">Transport Status</text><text x="679" y="322.05" text-anchor="middle" font-size="10" font-style="italic" fill="#10b981">Value Object</text></g><g class="d5-value-object"><rect x="58" y="350" width="234" height="49" rx="24.5" fill="white" stroke="#10b981" stroke-width="2"></rect><text x="175" y="370.05" text-anchor="middle" font-size="13" font-weight="600" fill="#1e293b">Routing Status</text><text x="175" y="389.05" text-anchor="middle" font-size="10" font-style="italic" fill="#10b981">Value Object</text></g><g class="d5-value-object"><rect x="310" y="350" width="234" height="49" rx="24.5" fill="white" stroke="#10b981" stroke-width="2"></rect><text x="427" y="370.05" text-anchor="middle" font-size="13" font-weight="600" fill="#1e293b">Estimated Time of Arrival</text><text x="427" y="389.05" text-anchor="middle" font-size="10" font-style="italic" fill="#10b981">Value Object</text></g><g class="d5-value-object"><rect x="562" y="350" width="234" height="49" rx="24.5" fill="white" stroke="#10b981" stroke-width="2"></rect><text x="679" y="370.05" text-anchor="middle" font-size="13" font-weight="600" fill="#1e293b">Last Known Location</text><text x="679" y="389.05" text-anchor="middle" font-size="10" font-style="italic" fill="#10b981">Value Object</text></g><g class="d5-value-object"><rect x="58" y="417" width="234" height="49" rx="24.5" fill="white" stroke="#10b981" stroke-width="2"></rect><text x="175" y="437.05" text-anchor="middle" font-size="13" font-weight="600" fill="#1e293b">Next Expected Handling Activity</text><text x="175" y="456.05" text-anchor="middle" font-size="10" font-style="italic" fill="#10b981">Value Object</text></g><g class="d5-invariants"><rect x="38" y="476" width="778" height="200" rx="6" fill="#fffbeb" stroke="#fcd34d" stroke-width="1" stroke-dasharray="4 3"></rect><text x="46" y="498.8" font-size="12" font-weight="bold" fill="#92400e">Invariants — enforced by root: Cargo</text><rect x="47" y="510" width="6" height="6" transform="rotate(45 50 513)" fill="#f59e0b"></rect><text x="62" y="516" font-size="12" fill="#78350f">A cargo's itinerary must satisfy its route specification: same origin and destination, and arrival no</text><text x="62" y="532" font-size="12" fill="#78350f">later than the deadline</text><rect x="47" y="551" width="6" height="6" transform="rotate(45 50 554)" fill="#f59e0b"></rect><text x="62" y="557" font-size="12" fill="#78350f">Delivery — Delivery is a pure projection of the registered handling-event history against the current</text><text x="62" y="573" font-size="12" fill="#78350f">itinerary and is never assigned directly</text><rect x="47" y="592" width="6" height="6" transform="rotate(45 50 595)" fill="#f59e0b"></rect><text x="62" y="598" font-size="12" fill="#78350f">Routing status is MISROUTED whenever the current itinerary does not satisfy the route specification</text><rect x="47" y="617" width="6" height="6" transform="rotate(45 50 620)" fill="#f59e0b"></rect><text x="62" y="623" font-size="12" fill="#78350f">Once transport status reaches CLAIMED the cargo is terminal and rejects any further handling events</text><rect x="47" y="642" width="6" height="6" transform="rotate(45 50 645)" fill="#f59e0b"></rect><text x="62" y="648" font-size="12" fill="#78350f">Assigning a new route specification recalculates routing status within the same transaction</text></g><g class="d5-legend"><rect x="30" y="720" width="14" height="14" rx="3" fill="white" stroke="#3b82f6" stroke-width="3"></rect><text x="50" y="731" font-size="11" fill="#64748b">Aggregate Root</text><rect x="156.43000000000004" y="720" width="14" height="14" rx="3" fill="white" stroke="#3b82f6" stroke-width="2"></rect><text x="176.43000000000004" y="731" font-size="11" fill="#64748b">Entity</text><rect x="234.35000000000002" y="720" width="14" height="14" rx="7" fill="white" stroke="#10b981" stroke-width="2"></rect><text x="254.35000000000002" y="731" font-size="11" fill="#64748b">Value Object</text></g>"`;

exports[`examples render regression > dddsample-core/aggregate-handling-event.md > matches SVG snapshot 1`] = `"<text class="d5-title" x="544" y="24" text-anchor="middle" font-size="18" font-weight="bold" fill="#1e293b">Handling Event Aggregate</text><g class="d5-aggregate"><rect x="30" y="70" width="1028" height="399" rx="12" fill="#f8fafc" stroke="#94a3b8" stroke-width="2" stroke-dasharray="8 4"></rect><text x="46" y="94" font-size="14" font-weight="600" fill="#475569">Aggregate: Handling Event</text></g><g class="d5-entity d5-aggregate-root"><rect x="58" y="134" width="972" height="58" rx="8" fill="#eff6ff" stroke="#3b82f6" stroke-width="3"></rect><text x="544" y="159" text-anchor="middle" font-size="15" font-weight="bold" fill="#1e293b">Handling Event</text><text x="544" y="177" text-anchor="middle" font-size="10" font-style="italic" fill="#3b82f6">Aggregate Root</text></g><g class="d5-value-object"><rect x="58" y="216" width="180" height="49" rx="24.5" fill="white" stroke="#10b981" stroke-width="2"></rect><text x="148" y="236.05" text-anchor="middle" font-size="13" font-weight="600" fill="#1e293b">Handling Type</text><text x="148" y="255.05" text-anchor="middle" font-size="10" font-style="italic" fill="#10b981">Value Object</text></g><g class="d5-value-object"><rect x="256" y="216" width="180" height="49" rx="24.5" fill="white" stroke="#10b981" stroke-width="2"></rect><text x="346" y="236.05" text-anchor="middle" font-size="13" font-weight="600" fill="#1e293b">Completion Time</text><text x="346" y="255.05" text-anchor="middle" font-size="10" font-style="italic" fill="#10b981">Value Object</text></g><g class="d5-value-object"><rect x="454" y="216" width="180" height="49" rx="24.5" fill="white" stroke="#10b981" stroke-width="2"></rect><text x="544" y="236.05" text-anchor="middle" font-size="13" font-weight="600" fill="#1e293b">Registration Time</text><text x="544" y="255.05" text-anchor="middle" font-size="10" font-style="italic" fill="#10b981">Value Object</text></g><g class="d5-value-object"><rect x="652" y="216" width="180" height="49" rx="24.5" fill="white" stroke="#10b981" stroke-width="2"></rect><text x="742" y="236.05" text-anchor="middle" font-size="13" font-weight="600" fill="#1e293b">Location (UN/LOCODE)</text><text x="742" y="255.05" text-anchor="middle" font-size="10" font-style="italic" fill="#10b981">Value Object</text></g><g class="d5-value-object"><rect x="850" y="216" width="180" height="49" rx="24.5" fill="white" stroke="#10b981" stroke-width="2"></rect><text x="940" y="236.05" text-anchor="middle" font-size="13" font-weight="600" fill="#1e293b">Voyage Number</text><text x="940" y="255.05" text-anchor="middle" font-size="10" font-style="italic" fill="#10b981">Value Object</text></g><g class="d5-invariants"><rect x="38" y="275" width="1012" height="166" rx="6" fill="#fffbeb" stroke="#fcd34d" stroke-width="1" stroke-dasharray="4 3"></rect><text x="46" y="297.8" font-size="12" font-weight="bold" fill="#92400e">Invariants — enforced by root: Handling Event</text><rect x="47" y="309" width="6" height="6" transform="rotate(45 50 312)" fill="#f59e0b"></rect><text x="62" y="315" font-size="12" fill="#78350f">Completion time (when the event happened) must not be after registration time (when the system was</text><text x="62" y="331" font-size="12" fill="#78350f">told about it)</text><rect x="47" y="350" width="6" height="6" transform="rotate(45 50 353)" fill="#f59e0b"></rect><text x="62" y="356" font-size="12" fill="#78350f">LOAD and UNLOAD events must carry a voyage number; RECEIVE, CLAIM and CUSTOMS events</text><text x="62" y="372" font-size="12" fill="#78350f">must not</text><rect x="47" y="391" width="6" height="6" transform="rotate(45 50 394)" fill="#f59e0b"></rect><text x="62" y="397" font-size="12" fill="#78350f">Type — Handling type is one of RECEIVE, LOAD, UNLOAD, CUSTOMS or CLAIM and is fixed at</text><text x="62" y="413" font-size="12" fill="#78350f">creation</text></g><g class="d5-legend"><rect x="30" y="485" width="14" height="14" rx="3" fill="white" stroke="#3b82f6" stroke-width="3"></rect><text x="50" y="496" font-size="11" fill="#64748b">Aggregate Root</text><rect x="156.43000000000004" y="485" width="14" height="14" rx="3" fill="white" stroke="#3b82f6" stroke-width="2"></rect><text x="176.43000000000004" y="496" font-size="11" fill="#64748b">Entity</text><rect x="234.35000000000002" y="485" width="14" height="14" rx="7" fill="white" stroke="#10b981" stroke-width="2"></rect><text x="254.35000000000002" y="496" font-size="11" fill="#64748b">Value Object</text></g>"`;

exports[`examples render regression > dddsample-core/aggregate-voyage.md > matches SVG snapshot 1`] = `"<text class="d5-title" x="302.5" y="24" text-anchor="middle" font-size="18" font-weight="bold" fill="#1e293b">Voyage Aggregate</text><g class="d5-aggregate"><rect x="30" y="70" width="545" height="367" rx="12" fill="#f8fafc" stroke="#94a3b8" stroke-width="2" stroke-dasharray="8 4"></rect><text x="46" y="94" font-size="14" font-weight="600" fill="#475569">Aggregate: Voyage</text></g><g class="d5-entity d5-aggregate-root"><rect x="58" y="134" width="489" height="58" rx="8" fill="#eff6ff" stroke="#3b82f6" stroke-width="3"></rect><text x="302.5" y="159" text-anchor="middle" font-size="15" font-weight="bold" fill="#1e293b">Voyage</text><text x="302.5" y="177" text-anchor="middle" font-size="10" font-style="italic" fill="#3b82f6">Aggregate Root</text></g><g class="d5-value-object"><rect x="58" y="216" width="151" height="49" rx="24.5" fill="white" stroke="#10b981" stroke-width="2"></rect><text x="133.5" y="236.05" text-anchor="middle" font-size="13" font-weight="600" fill="#1e293b">Voyage Number</text><text x="133.5" y="255.05" text-anchor="middle" font-size="10" font-style="italic" fill="#10b981">Value Object</text></g><g class="d5-value-object"><rect x="227" y="216" width="151" height="49" rx="24.5" fill="white" stroke="#10b981" stroke-width="2"></rect><text x="302.5" y="236.05" text-anchor="middle" font-size="13" font-weight="600" fill="#1e293b">Schedule</text><text x="302.5" y="255.05" text-anchor="middle" font-size="10" font-style="italic" fill="#10b981">Value Object</text></g><g class="d5-value-object"><rect x="396" y="216" width="151" height="49" rx="24.5" fill="white" stroke="#10b981" stroke-width="2"></rect><text x="471.5" y="236.05" text-anchor="middle" font-size="13" font-weight="600" fill="#1e293b">Carrier Movement</text><text x="471.5" y="255.05" text-anchor="middle" font-size="10" font-style="italic" fill="#10b981">Value Object</text></g><g class="d5-invariants"><rect x="38" y="275" width="529" height="134" rx="6" fill="#fffbeb" stroke="#fcd34d" stroke-width="1" stroke-dasharray="4 3"></rect><text x="46" y="297.8" font-size="12" font-weight="bold" fill="#92400e">Invariants — enforced by root: Voyage</text><rect x="47" y="309" width="6" height="6" transform="rotate(45 50 312)" fill="#f59e0b"></rect><text x="62" y="315" font-size="12" fill="#78350f">Carrier movements in the schedule are contiguous: each one departs from the</text><text x="62" y="331" font-size="12" fill="#78350f">arrival location of the previous movement</text><rect x="47" y="350" width="6" height="6" transform="rotate(45 50 353)" fill="#f59e0b"></rect><text x="62" y="356" font-size="12" fill="#78350f">Every carrier movement arrives strictly after it departs</text><rect x="47" y="375" width="6" height="6" transform="rotate(45 50 378)" fill="#f59e0b"></rect><text x="62" y="381" font-size="12" fill="#78350f">Voyage number is immutable once the voyage has been created</text></g><g class="d5-legend"><rect x="30" y="453" width="14" height="14" rx="3" fill="white" stroke="#3b82f6" stroke-width="3"></rect><text x="50" y="464" font-size="11" fill="#64748b">Aggregate Root</text><rect x="156.43000000000004" y="453" width="14" height="14" rx="3" fill="white" stroke="#3b82f6" stroke-width="2"></rect><text x="176.43000000000004" y="464" font-size="11" fill="#64748b">Entity</text><rect x="234.35000000000002" y="453" width="14" height="14" rx="7" fill="white" stroke="#10b981" stroke-width="2"></rect><text x="254.35000000000002" y="464" font-size="11" fill="#64748b">Value Object</text></g>"`;

exports[`examples render regression > dddsample-core/context-booking.md > matches SVG snapshot 1`] = `"<defs><marker id="d5-arrowhead" markerWidth="8" markerHeight="8" refX="8" refY="4" orient="auto"><path d="M0,0 L8,4 L0,8" fill="#64748b"></path></marker><marker id="d5-event-arrowhead" markerWidth="8" markerHeight="8" refX="8" refY="4" orient="auto"><path d="M0,0 L8,4 L0,8" fill="#d97706"></path></marker><marker id="d5-policy-arrowhead" markerWidth="8" markerHeight="8" refX="8" refY="4" orient="auto"><path d="M0,0 L8,4 L0,8" fill="#7c3aed"></path></marker></defs><text class="d5-title" x="820.5" y="24" text-anchor="middle" font-size="18" font-weight="bold" fill="#1e293b">Booking &amp; Contract Management Context</text><g class="d5-bounded-context"><rect x="30" y="64" width="1581" height="773" rx="12" fill="#f8fafc" stroke="#94a3b8" stroke-width="2" stroke-dasharray="8 4"></rect><text x="46" y="88" font-size="14" font-weight="600" fill="#475569">Booking &amp; Contract Management</text><text x="1595" y="88" font-size="12" font-style="italic" fill="#64748b" text-anchor="end">Team: Booking Team</text></g><g class="d5-language-note"><rect x="1253" y="130" width="328" height="464" rx="4" fill="#fef9c3" stroke="#ca8a04" stroke-width="1.5"></rect><path d="M1253,160 L1253,134 Q1253,130 1257,130 L1577,130 Q1581,130 1581,134 L1581,160 Z" fill="#fde047"></path><text x="1417" y="150" text-anchor="middle" font-size="12" font-weight="bold" fill="#854d0e">Ubiquitous Language</text><text x="1267" y="184.2" font-size="12" font-weight="bold" fill="#713f12">Cargo:</text><text x="1267" y="202.2" font-size="11" fill="#854d0e">A shipment booked by a customer, identified by a tracking</text><text x="1267" y="216.2" font-size="11" fill="#854d0e">id and followed from the booking desk through to the</text><text x="1267" y="230.2" font-size="11" fill="#854d0e">moment it is claimed at destination</text><text x="1267" y="256.2" font-size="12" font-weight="bold" fill="#713f12">Route Specification:</text><text x="1267" y="274.2" font-size="11" fill="#854d0e">The origin, destination and arrival deadline that any</text><text x="1267" y="288.2" font-size="11" fill="#854d0e">itinerary assigned to a cargo must satisfy for the cargo to</text><text x="1267" y="302.2" font-size="11" fill="#854d0e">count as correctly routed</text><text x="1267" y="328.2" font-size="12" font-weight="bold" fill="#713f12">Itinerary:</text><text x="1267" y="346.2" font-size="11" fill="#854d0e">The ordered sequence of legs describing exactly how a</text><text x="1267" y="360.2" font-size="11" fill="#854d0e">cargo is loaded onto and unloaded from voyages on its</text><text x="1267" y="374.2" font-size="11" fill="#854d0e">way to the destination</text><text x="1267" y="400.2" font-size="12" font-weight="bold" fill="#713f12">Leg:</text><text x="1267" y="418.2" font-size="11" fill="#854d0e">The load of a cargo onto one voyage at one location and its</text><text x="1267" y="432.2" font-size="11" fill="#854d0e">unload from that same voyage at a later location</text><text x="1267" y="458.2" font-size="12" font-weight="bold" fill="#713f12">Delivery:</text><text x="1267" y="476.2" font-size="11" fill="#854d0e">The current delivery progress of a cargo, derived by</text><text x="1267" y="490.2" font-size="11" fill="#854d0e">replaying its registered handling events against its</text><text x="1267" y="504.2" font-size="11" fill="#854d0e">current itinerary</text><text x="1267" y="530.2" font-size="12" font-weight="bold" fill="#713f12">Misrouted:</text><text x="1267" y="548.2" font-size="11" fill="#854d0e">The state of a cargo whose current itinerary no longer</text><text x="1267" y="562.2" font-size="11" fill="#854d0e">satisfies its route specification and therefore needs</text><text x="1267" y="576.2" font-size="11" fill="#854d0e">re-routing</text></g><g class="d5-aggregate"><rect x="332.75" y="403" width="180" height="186" rx="8" fill="white" stroke="#3b82f6" stroke-width="2"></rect><path d="M332.75,437 L332.75,411 Q332.75,403 340.75,403 L504.75,403 Q512.75,403 512.75,411 L512.75,437 Z" fill="#dbeafe"></path><line x1="332.75" y1="437" x2="512.75" y2="437" stroke="#3b82f6" stroke-width="1.5"></line><text x="422.75" y="423" text-anchor="middle" font-size="13" font-weight="bold" fill="#1e293b">Cargo</text><text x="422.75" y="457" text-anchor="middle" font-size="11" font-style="italic" fill="#3b82f6">Root: Cargo</text><line x1="342.75" y1="469" x2="502.75" y2="469" stroke="#cbd5e1" stroke-dasharray="4 4"></line><circle cx="352.75" cy="483" r="3" fill="#94a3b8"></circle><text x="362.75" y="487" font-size="12" fill="#475569">Tracking ID</text><circle cx="352.75" cy="503" r="3" fill="#94a3b8"></circle><text x="362.75" y="507" font-size="12" fill="#475569">Route Specification</text><circle cx="352.75" cy="523" r="3" fill="#94a3b8"></circle><text x="362.75" y="527" font-size="12" fill="#475569">Itinerary</text><circle cx="352.75" cy="543" r="3" fill="#94a3b8"></circle><text x="362.75" y="547" font-size="12" fill="#475569">Delivery</text><circle cx="352.75" cy="563" r="3" fill="#94a3b8"></circle><text x="362.75" y="567" font-size="12" fill="#475569">Customs Status</text></g><g class="d5-aggregate"><rect x="129.5" y="681" width="180" height="126" rx="8" fill="white" stroke="#3b82f6" stroke-width="2"></rect><path d="M129.5,715 L129.5,689 Q129.5,681 137.5,681 L301.5,681 Q309.5,681 309.5,689 L309.5,715 Z" fill="#dbeafe"></path><line x1="129.5" y1="715" x2="309.5" y2="715" stroke="#3b82f6" stroke-width="1.5"></line><text x="219.5" y="701" text-anchor="middle" font-size="13" font-weight="bold" fill="#1e293b">Location</text><text x="219.5" y="735" text-anchor="middle" font-size="11" font-style="italic" fill="#3b82f6">Root: Location</text><line x1="139.5" y1="747" x2="299.5" y2="747" stroke="#cbd5e1" stroke-dasharray="4 4"></line><circle cx="149.5" cy="761" r="3" fill="#94a3b8"></circle><text x="159.5" y="765" font-size="12" fill="#475569">UN/LOCODE</text><circle cx="149.5" cy="781" r="3" fill="#94a3b8"></circle><text x="159.5" y="785" font-size="12" fill="#475569">Name</text></g><g class="d5-aggregate"><rect x="689" y="681" width="180" height="126" rx="8" fill="white" stroke="#3b82f6" stroke-width="2"></rect><path d="M689,715 L689,689 Q689,681 697,681 L861,681 Q869,681 869,689 L869,715 Z" fill="#dbeafe"></path><line x1="689" y1="715" x2="869" y2="715" stroke="#3b82f6" stroke-width="1.5"></line><text x="779" y="701" text-anchor="middle" font-size="13" font-weight="bold" fill="#1e293b">Voyage</text><text x="779" y="735" text-anchor="middle" font-size="11" font-style="italic" fill="#3b82f6">Root: Voyage</text><line x1="699" y1="747" x2="859" y2="747" stroke="#cbd5e1" stroke-dasharray="4 4"></line><circle cx="709" cy="761" r="3" fill="#94a3b8"></circle><text x="719" y="765" font-size="12" fill="#475569">Voyage Number</text><circle cx="709" cy="781" r="3" fill="#94a3b8"></circle><text x="719" y="785" font-size="12" fill="#475569">Schedule</text></g><g class="d5-aggregate"><rect x="814" y="130" width="180" height="166" rx="8" fill="white" stroke="#3b82f6" stroke-width="2"></rect><path d="M814,164 L814,138 Q814,130 822,130 L986,130 Q994,130 994,138 L994,164 Z" fill="#dbeafe"></path><line x1="814" y1="164" x2="994" y2="164" stroke="#3b82f6" stroke-width="1.5"></line><text x="904" y="150" text-anchor="middle" font-size="13" font-weight="bold" fill="#1e293b">Handling Event</text><text x="904" y="184" text-anchor="middle" font-size="11" font-style="italic" fill="#3b82f6">Root: Handling Event</text><line x1="824" y1="196" x2="984" y2="196" stroke="#cbd5e1" stroke-dasharray="4 4"></line><circle cx="834" cy="210" r="3" fill="#94a3b8"></circle><text x="844" y="214" font-size="12" fill="#475569">Type</text><circle cx="834" cy="230" r="3" fill="#94a3b8"></circle><text x="844" y="234" font-size="12" fill="#475569">Completion Time</text><circle cx="834" cy="250" r="3" fill="#94a3b8"></circle><text x="844" y="254" font-size="12" fill="#475569">Location</text><circle cx="834" cy="270" r="3" fill="#94a3b8"></circle><text x="844" y="274" font-size="12" fill="#475569">Voyage</text></g><g class="d5-aggregate"><rect x="147" y="140" width="180" height="146" rx="8" fill="white" stroke="#3b82f6" stroke-width="2"></rect><path d="M147,174 L147,148 Q147,140 155,140 L319,140 Q327,140 327,148 L327,174 Z" fill="#dbeafe"></path><line x1="147" y1="174" x2="327" y2="174" stroke="#3b82f6" stroke-width="1.5"></line><text x="237" y="160" text-anchor="middle" font-size="13" font-weight="bold" fill="#1e293b">Customs Clearance</text><text x="237" y="194" text-anchor="middle" font-size="11" font-style="italic" fill="#3b82f6">Root: Clearance</text><line x1="157" y1="206" x2="317" y2="206" stroke="#cbd5e1" stroke-dasharray="4 4"></line><circle cx="167" cy="220" r="3" fill="#94a3b8"></circle><text x="177" y="224" font-size="12" fill="#475569">Status</text><circle cx="167" cy="240" r="3" fill="#94a3b8"></circle><text x="177" y="244" font-size="12" fill="#475569">Clearance Point</text><circle cx="167" cy="260" r="3" fill="#94a3b8"></circle><text x="177" y="264" font-size="12" fill="#475569">Cleared At</text></g><g class="d5-read-model"><rect x="929" y="707" width="180" height="74" rx="6" fill="white" stroke="#64748b" stroke-width="2"></rect><path d="M929,737 L929,713 Q929,707 935,707 L1103,707 Q1109,707 1109,713 L1109,737 Z" fill="#f1f5f9"></path><line x1="929" y1="737" x2="1109" y2="737" stroke="#64748b" stroke-width="1"></line><text x="1019" y="726" text-anchor="middle" font-size="13" font-weight="bold" fill="#1e293b">Cargo Tracking View</text><text x="1019" y="753" text-anchor="middle" font-size="10" font-style="italic" fill="#64748b">read model</text><line x1="941" y1="767" x2="1097" y2="767" stroke="#e2e8f0" stroke-width="1"></line><line x1="941" y1="776" x2="1097" y2="776" stroke="#e2e8f0" stroke-width="1"></line></g><g class="d5-rel"><path d="M 332.75 557.549815498155 Q 219.5 635 219.5 658 L 219.5 681" fill="none" stroke="#64748b" stroke-width="1.5" marker-end="url(#d5-arrowhead)"></path><g class="d5-edge-label"><rect x="145.5" y="619" width="148" height="32" rx="4" fill="white" fill-opacity="0.92" stroke="#cbd5e1" stroke-width="1"></rect><text x="219.5" y="630.2" text-anchor="middle" font-size="10" font-weight="600" fill="#475569">origin &amp; destination</text><text x="219.5" y="643.2" text-anchor="middle" font-size="10" font-weight="600" fill="#475569">referenced by UN/LOCODE</text></g></g><g class="d5-rel"><path d="M 422.75 589 Q 422.75 635 555.875 675.7315789473685 L 689 716.4631578947368" fill="none" stroke="#64748b" stroke-width="1.5" marker-end="url(#d5-arrowhead)"></path><g class="d5-edge-label"><rect x="350.25" y="619" width="145" height="32" rx="4" fill="white" fill-opacity="0.92" stroke="#cbd5e1" stroke-width="1"></rect><text x="422.75" y="630.2" text-anchor="middle" font-size="10" font-weight="600" fill="#475569">itinerary legs reference</text><text x="422.75" y="643.2" text-anchor="middle" font-size="10" font-weight="600" fill="#475569">voyages by voyage number</text></g></g><g class="d5-rel"><path d="M 814 241.11212814645307 Q 467 349.5 458.92022184300345 376.25 L 450.84044368600684 403" fill="none" stroke="#64748b" stroke-width="1.5" marker-end="url(#d5-arrowhead)"></path><g class="d5-edge-label"><rect x="391" y="333.5" width="152" height="32" rx="4" fill="white" fill-opacity="0.92" stroke="#cbd5e1" stroke-width="1"></rect><text x="467" y="344.7" text-anchor="middle" font-size="10" font-weight="600" fill="#475569">recorded against a cargo by</text><text x="467" y="357.7" text-anchor="middle" font-size="10" font-weight="600" fill="#475569">tracking id</text></g></g><g class="d5-rel"><path d="M 857.1794871794872 296 Q 827 349.5 827 422.75 Q 827 496 827 565.5 Q 827 635 816.8715596330276 658 L 806.743119266055 681" fill="none" stroke="#64748b" stroke-width="1.5" marker-end="url(#d5-arrowhead)"></path><g class="d5-edge-label"><rect x="749" y="480" width="156" height="32" rx="4" fill="white" f