exports[`examples render regression > ddd-by-examples-library/aggregate-book.md > matches SVG snapshot 1`] = `"<text class="d5-title" x="469" y="24" text-anchor="middle" font-size="18" font-weight="bold" fill="#1e293b">Book Aggregate</text><g class="d5-aggregate"><rect x="30" y="70" width="878" height="459" rx="12" fill="#f8fafc" stroke="#94a3b8" stroke-width="2" stroke-dasharray="8 4"></rect><text x="46" y="94" font-size="14" font-weight="600" fill="#475569">Aggregate: Book</text></g><g class="d5-entity d5-aggregate-root"><rect x="58" y="134" width="822" height="58" rx="8" fill="#eff6ff" stroke="#3b82f6" stroke-width="3"></rect><text x="469" y="159" text-anchor="middle" font-size="15" font-weight="bold" fill="#1e293b">Book</text><text x="469" y="177" text-anchor="middle" font-size="10" font-style="italic" fill="#3b82f6">Aggregate Root</text></g><g class="d5-value-object"><rect x="58" y="216" width="150" height="49" rx="24.5" fill="white" stroke="#10b981" stroke-width="2"></rect><text x="133" y="236.05" text-anchor="middle" font-size="13" font-weight="600" fill="#1e293b">Book ID</text><text x="133" y="255.05" text-anchor="middle" font-size="10" font-style="italic" fill="#10b981">Value Object</text></g><g class="d5-value-object"><rect x="226" y="216" width="150" height="49" rx="24.5" fill="white" stroke="#10b981" stroke-width="2"></rect><text x="301" y="236.05" text-anchor="middle" font-size="13" font-weight="600" fill="#1e293b">Book State</text><text x="301" y="255.05" text-anchor="middle" font-size="10" font-style="italic" fill="#10b981">Value Object</text></g><g class="d5-value-object"><rect x="394" y="216" width="150" height="49" rx="24.5" fill="white" stroke="#10b981" stroke-width="2"></rect><text x="469" y="236.05" text-anchor="middle" font-size="13" font-weight="600" fill="#1e293b">Book Type</text><text x="469" y="255.05" text-anchor="middle" font-size="10" font-style="italic" fill="#10b981">Value Object</text></g><g class="d5-value-object"><rect x="562" y="216" width="150" height="49" rx="24.5" fill="white" stroke="#10b981" stroke-width="2"></rect><text x="637" y="236.05" text-anchor="middle" font-size="13" font-weight="600" fill="#1e293b">Library Branch</text><text x="637" y="255.05" text-anchor="middle" font-size="10" font-style="italic" fill="#10b981">Value Object</text></g><g class="d5-value-object"><rect x="730" y="216" width="150" height="49" rx="24.5" fill="white" stroke="#10b981" stroke-width="2"></rect><text x="805" y="236.05" text-anchor="middle" font-size="13" font-weight="600" fill="#1e293b">Bound To Patron</text><text x="805" y="255.05" text-anchor="middle" font-size="10" font-style="italic" fill="#10b981">Value Object</text></g><g class="d5-value-object"><rect x="58" y="283" width="150" height="49" rx="24.5" fill="white" stroke="#10b981" stroke-width="2"></rect><text x="133" y="303.05" text-anchor="middle" font-size="13" font-weight="600" fill="#1e293b">Hold Placed At</text><text x="133" y="322.05" text-anchor="middle" font-size="10" font-style="italic" fill="#10b981">Value Object</text></g><g class="d5-invariants"><rect x="38" y="342" width="862" height="159" rx="6" fill="#fffbeb" stroke="#fcd34d" stroke-width="1" stroke-dasharray="4 3"></rect><text x="46" y="364.8" font-size="12" font-weight="bold" fill="#92400e">Invariants — enforced by root: Book</text><rect x="47" y="376" width="6" height="6" transform="rotate(45 50 379)" fill="#f59e0b"></rect><text x="62" y="382" font-size="12" fill="#78350f">A book is in exactly one state at a time: Available, On Hold, or Checked Out</text><rect x="47" y="401" width="6" height="6" transform="rotate(45 50 404)" fill="#f59e0b"></rect><text x="62" y="407" font-size="12" fill="#78350f">An available book can be placed on hold by at most one patron</text><rect x="47" y="426" width="6" height="6" transform="rotate(45 50 429)" fill="#f59e0b"></rect><text x="62" y="432" font-size="12" fill="#78350f">State — State only moves Available → On Hold → Checked Out → Available; cancelling a hold returns the</text><text x="62" y="448" font-size="12" fill="#78350f">book straight to Available</text><rect x="47" y="467" width="6" height="6" transform="rotate(45 50 470)" fill="#f59e0b"></rect><text x="62" y="473" font-size="12" fill="#78350f">A book that is On Hold or Checked Out always records the patron and the branch it is bound to</text></g><g class="d5-legend"><rect x="30" y="545" width="14" height="14" rx="3" fill="white" stroke="#3b82f6" stroke-width="3"></rect><text x="50" y="556" font-size="11" fill="#64748b">Aggregate Root</text><rect x="156.43000000000004" y="545" width="14" height="14" rx="3" fill="white" stroke="#3b82f6" stroke-width="2"></rect><text x="176.43000000000004" y="556" font-size="11" fill="#64748b">Entity</text><rect x="234.35000000000002" y="545" width="14" height="14" rx="7" fill="white" stroke="#10b981" stroke-width="2"></rect><text x="254.35000000000002" y="556" font-size="11" fill="#64748b">Value Object</text></g>"`;

exports[`examples render regression > ddd-by-examples-library/aggregate-library-branch.md > matches SVG snapshot 1`] = `"<text class="d5-title" x="218" y="24" text-anchor="middle" font-size="18" font-weight="bold" fill="#1e293b">Library Branch Aggregate</text><g class="d5-aggregate"><rect x="30" y="70" width="376" height="317" rx="12" fill="#f8fafc" stroke="#94a3b8" stroke-width="2" stroke-dasharray="8 4"></rect><text x="46" y="94" font-size="14" font-weight="600" fill="#475569">Aggregate: Library Branch</text></g><g class="d5-entity d5-aggregate-root"><rect x="58" y="134" width="320" height="58" rx="8" fill="#eff6ff" stroke="#3b82f6" stroke-width="3"></rect><text x="218" y="159" text-anchor="middle" font-size="15" font-weight="bold" fill="#1e293b">Library Branch</text><text x="218" y="177" text-anchor="middle" font-size="10" font-style="italic" fill="#3b82f6">Aggregate Root</text></g><g class="d5-value-object"><rect x="59" y="216" width="150" height="49" rx="24.5" fill="white" stroke="#10b981" stroke-width="2"></rect><text x="134" y="236.05" text-anchor="middle" font-size="13" font-weight="600" fill="#1e293b">Library Branch ID</text><text x="134" y="255.05" text-anchor="middle" font-size="10" font-style="italic" fill="#10b981">Value Object</text></g><g class="d5-value-object"><rect x="227" y="216" width="150" height="49" rx="24.5" fill="white" stroke="#10b981" stroke-width="2"></rect><text x="302" y="236.05" text-anchor="middle" font-size="13" font-weight="600" fill="#1e293b">Branch Name</text><text x="302" y="255.05" text-anchor="middle" font-size="10" font-style="italic" fill="#10b981">Value Object</text></g><g class="d5-invariants"><rect x="38" y="275" width="360" height="84" rx="6" fill="#fffbeb" stroke="#fcd34d" stroke-width="1" stroke-dasharray="4 3"></rect><text x="46" y="297.8" font-size="12" font-weight="bold" fill="#92400e">Invariants — enforced by root: Library Branch</text><rect x="47" y="309" width="6" height="6" transform="rotate(45 50 312)" fill="#f59e0b"></rect><text x="62" y="315" font-size="12" fill="#78350f">A library branch is identified by a stable code</text><text x="62" y="331" font-size="12" fill="#78350f">that never changes once assigned</text></g><g class="d5-legend"><rect x="30" y="403" width="14" height="14" rx="3" fill="white" stroke="#3b82f6" stroke-width="3"></rect><text x="50" y="414" font-size="11" fill="#64748b">Aggregate Root</text><rect x="156.43000000000004" y="403" width="14" height="14" rx="3" fill="white" stroke="#3b82f6" stroke-width="2"></rect><text x="176.43000000000004" y="414" font-size="11" fill="#64748b">Entity</text><rect x="234.35000000000002" y="403" width="14" height="14" rx="7" fill="white" stroke="#10b981" stroke-width="2"></rect><text x="254.35000000000002" y="414" font-size="11" fill="#64748b">Value Object</text></g>"`;

exports[`examples render regression > ddd-by-examples-library/aggregate-patron.md > matches SVG snapshot 1`] = `"<text class="d5-title" x="479" y="24" text-anchor="middle" font-size="18" font-weight="bold" fill="#1e293b">Patron Aggregate</text><g class="d5-aggregate"><rect x="30" y="70" width="898" height="484" rx="12" fill="#f8fafc" stroke="#94a3b8" stroke-width="2" stroke-dasharray="8 4"></rect><text x="46" y="94" font-size="14" font-weight="600" fill="#475569">Aggregate: Patron</text></g><g class="d5-entity d5-aggregate-root"><rect x="58" y="134" width="842" height="58" rx="8" fill="#eff6ff" stroke="#3b82f6" stroke-width="3"></rect><text x="479" y="159" text-anchor="middle" font-size="15" font-weight="bold" fill="#1e293b">Patron</text><text x="479" y="177" text-anchor="middle" font-size="10" font-style="italic" fill="#3b82f6">Aggregate Root</text></g><g class="d5-value-object"><rect x="58" y="216" width="154" height="49" rx="24.5" fill="white" stroke="#10b981" stroke-width="2"></rect><text x="135" y="236.05" text-anchor="middle" font-size="13" font-weight="600" fill="#1e293b">Patron ID</text><text x="135" y="255.05" text-anchor="middle" font-size="10" font-style="italic" fill="#10b981">Value Object</text></g><g class="d5-value-object"><rect x="230" y="216" width="154" height="49" rx="24.5" fill="white" stroke="#10b981" stroke-width="2"></rect><text x="307" y="236.05" text-anchor="middle" font-size="13" font-weight="600" fill="#1e293b">Patron Type</text><text x="307" y="255.05" text-anchor="middle" font-size="10" font-style="italic" fill="#10b981">Value Object</text></g><g class="d5-value-object"><rect x="402" y="216" width="154" height="49" rx="24.5" fill="white" stroke="#10b981" stroke-width="2"></rect><text x="479" y="236.05" text-anchor="middle" font-size="13" font-weight="600" fill="#1e293b">Patron Holds</text><text x="479" y="255.05" text-anchor="middle" font-size="10" font-style="italic" fill="#10b981">Value Object</text></g><g class="d5-value-object"><rect x="574" y="216" width="154" height="49" rx="24.5" fill="white" stroke="#10b981" stroke-width="2"></rect><text x="651" y="236.05" text-anchor="middle" font-size="13" font-weight="600" fill="#1e293b">Hold</text><text x="651" y="255.05" text-anchor="middle" font-size="10" font-style="italic" fill="#10b981">Value Object</text></g><g class="d5-value-object"><rect x="746" y="216" width="154" height="49" rx="24.5" fill="white" stroke="#10b981" stroke-width="2"></rect><text x="823" y="236.05" text-anchor="middle" font-size="13" font-weight="600" fill="#1e293b">Hold Duration</text><text x="823" y="255.05" text-anchor="middle" font-size="10" font-style="italic" fill="#10b981">Value Object</text></g><g class="d5-value-object"><rect x="58" y="283" width="154" height="49" rx="24.5" fill="white" stroke="#10b981" stroke-width="2"></rect><text x="135" y="303.05" text-anchor="middle" font-size="13" font-weight="600" fill="#1e293b">Overdue Checkouts</text><text x="135" y="322.05" text-anchor="middle" font-size="10" font-style="italic" fill="#10b981">Value Object</text></g><g class="d5-invariants"><rect x="38" y="342" width="882" height="184" rx="6" fill="#fffbeb" stroke="#fcd34d" stroke-width="1" stroke-dasharray="4 3"></rect><text x="46" y="364.8" font-size="12" font-weight="bold" fill="#92400e">Invariants — enforced by root: Patron</text><rect x="47" y="376" width="6" height="6" transform="rotate(45 50 379)" fill="#f59e0b"></rect><text x="62" y="382" font-size="12" fill="#78350f">A regular patron holds at most 5 books at any moment; a researcher patron has no hold limit</text><rect x="47" y="401" width="6" height="6" transform="rotate(45 50 404)" fill="#f59e0b"></rect><text x="62" y="407" font-size="12" fill="#78350f">Only a researcher patron may place a hold on a restricted book — a regular patron is always rejected</text><rect x="47" y="426" width="6" height="6" transform="rotate(45 50 429)" fill="#f59e0b"></rect><text x="62" y="432" font-size="12" fill="#78350f">Only a researcher patron may request an open-ended hold duration</text><rect x="47" y="451" width="6" height="6" transform="rotate(45 50 454)" fill="#f59e0b"></rect><text x="62" y="457" font-size="12" fill="#78350f">A patron with more than 2 overdue checkouts at a branch cannot place a hold at that same branch</text><rect x="47" y="476" width="6" height="6" transform="rotate(45 50 479)" fill="#f59e0b"></rect><text x="62" y="482" font-size="12" fill="#78350f">Hold — A hold can be cancelled only while it is active — never once it has been completed or has</text><text x="62" y="498" font-size="12" fill="#78350f">expired</text></g><g class="d5-legend"><rect x="30" y="570" width="14" height="14" rx="3" fill="white" stroke="#3b82f6" stroke-width="3"></rect><text x="50" y="581" font-size="11" fill="#64748b">Aggregate Root</text><rect x="156.43000000000004" y="570" width="14" height="14" rx="3" fill="white" stroke="#3b82f6" stroke-width="2"></rect><text x="176.43000000000004" y="581" font-size="11" fill="#64748b">Entity</text><rect x="234.35000000000002" y="570" width="14" height="14" rx="7" fill="white" stroke="#10b981" stroke-width="2"></rect><text x="254.35000000000002" y="581" font-size="11" fill="#64748b">Value Object</text></g>"`;

exports[`examples render regression > ddd-by-examples-library/context-lending.md > matches SVG snapshot 1`] = `"<defs><marker id="d5-arrowhead" markerWidth="8" markerHeight="8" refX="8" refY="4" orient="auto"><path d="M0,0 L8,4 L0,8" fill="#64748b"></path></marker><marker id="d5-event-arrowhead" markerWidth="8" markerHeight="8" refX="8" refY="4" orient="auto"><path d="M0,0 L8,4 L0,8" fill="#d97706"></path></marker><marker id="d5-policy-arrowhead" markerWidth="8" markerHeight="8" refX="8" refY="4" orient="auto"><path d="M0,0 L8,4 L0,8" fill="#7c3aed"></path></marker></defs><text class="d5-title" x="754.5" y="24" text-anchor="middle" font-size="18" font-weight="bold" fill="#1e293b">Lending Context — Tactical Structure</text><g class="d5-bounded-context"><rect x="30" y="64" width="1449" height="562" rx="12" fill="#f8fafc" stroke="#94a3b8" stroke-width="2" stroke-dasharray="8 4"></rect><text x="46" y="88" font-size="14" font-weight="600" fill="#475569">Lending</text><text x="1463" y="88" font-size="12" font-style="italic" fill="#64748b" text-anchor="end">Team: Lending Team</text></g><g class="d5-language-note"><rect x="1121" y="130" width="328" height="466" rx="4" fill="#fef9c3" stroke="#ca8a04" stroke-width="1.5"></rect><path d="M1121,160 L1121,134 Q1121,130 1125,130 L1445,130 Q1449,130 1449,134 L1449,160 Z" fill="#fde047"></path><text x="1285" y="150" text-anchor="middle" font-size="12" font-weight="bold" fill="#854d0e">Ubiquitous Language</text><text x="1135" y="184.2" font-size="12" font-weight="bold" fill="#713f12">Hold:</text><text x="1135" y="202.2" font-size="11" fill="#854d0e">A patron's claim on an available book at a branch; blocks</text><text x="1135" y="216.2" font-size="11" fill="#854d0e">every other patron until the book is checked out, the hold</text><text x="1135" y="230.2" font-size="11" fill="#854d0e">is cancelled, or it expires</text><text x="1135" y="256.2" font-size="12" font-weight="bold" fill="#713f12">Open-ended Hold:</text><text x="1135" y="274.2" font-size="11" fill="#854d0e">A hold with no expiry date, active until the patron checks</text><text x="1135" y="288.2" font-size="11" fill="#854d0e">the book out; only a researcher patron may request one</text><text x="1135" y="314.2" font-size="12" font-weight="bold" fill="#713f12">Closed-ended Hold:</text><text x="1135" y="332.2" font-size="11" fill="#854d0e">A hold that expires a fixed number of days after it is</text><text x="1135" y="346.2" font-size="11" fill="#854d0e">requested if the book has not been checked out by then</text><text x="1135" y="372.2" font-size="12" font-weight="bold" fill="#713f12">Checkout:</text><text x="1135" y="390.2" font-size="11" fill="#854d0e">A patron's borrowing of a book for up to 60 days; it</text><text x="1135" y="404.2" font-size="11" fill="#854d0e">becomes an overdue checkout once that limit passes</text><text x="1135" y="430.2" font-size="12" font-weight="bold" fill="#713f12">Available Book:</text><text x="1135" y="448.2" font-size="11" fill="#854d0e">A catalogued book instance at a branch that no patron</text><text x="1135" y="462.2" font-size="11" fill="#854d0e">currently holds or has checked out</text><text x="1135" y="488.2" font-size="12" font-weight="bold" fill="#713f12">Restricted Book:</text><text x="1135" y="506.2" font-size="11" fill="#854d0e">A book that only a researcher patron is allowed to place</text><text x="1135" y="520.2" font-size="11" fill="#854d0e">on hold; a regular patron is always rejected</text><text x="1135" y="546.2" font-size="12" font-weight="bold" fill="#713f12">Overdue Checkout:</text><text x="1135" y="564.2" font-size="11" fill="#854d0e">A checkout that has not been returned more than 60 days</text><text x="1135" y="578.2" font-size="11" fill="#854d0e">after it began; counted per branch against the patron</text></g><g class="d5-aggregate"><rect x="60" y="257.625" width="180" height="146" rx="8" fill="white" stroke="#3b82f6" stroke-width="2"></rect><path d="M60,291.625 L60,265.625 Q60,257.625 68,257.625 L232,257.625 Q240,257.625 240,265.625 L240,291.625 Z" fill="#dbeafe"></path><line x1="60" y1="291.625" x2="240" y2="291.625" stroke="#3b82f6" stroke-width="1.5"></line><text x="150" y="277.625" text-anchor="middle" font-size="13" font-weight="bold" fill="#1e293b">Patron</text><text x="150" y="311.625" text-anchor="middle" font-size="11" font-style="italic" fill="#3b82f6">Root: Patron</text><line x1="70" y1="323.625" x2="230" y2="323.625" stroke="#cbd5e1" stroke-dasharray="4 4"></line><circle cx="80" cy="337.625" r="3" fill="#94a3b8"></circle><text x="90" y="341.625" font-size="12" fill="#475569">Patron Type</text><circle cx="80" cy="357.625" r="3" fill="#94a3b8"></circle><text x="90" y="361.625" font-size="12" fill="#475569">Patron Holds</text><circle cx="80" cy="377.625" r="3" fill="#94a3b8"></circle><text x="90" y="381.625" font-size="12" fill="#475569">Overdue Checkouts</text></g><g class="d5-aggregate"><rect x="455" y="224.875" width="180" height="166" rx="8" fill="white" stroke="#3b82f6" stroke-width="2"></rect><path d="M455,258.875 L455,232.875 Q455,224.875 463,224.875 L627,224.875 Q635,224.875 635,232.875 L635,258.875 Z" fill="#dbeafe"></path><line x1="455" y1="258.875" x2="635" y2="258.875" stroke="#3b82f6" stroke-width="1.5"></line><text x="545" y="244.875" text-anchor="middle" font-size="13" font-weight="bold" fill="#1e293b">Book</text><text x="545" y="278.875" text-anchor="middle" font-size="11" font-style="italic" fill="#3b82f6">Root: Book</text><line x1="465" y1="290.875" x2="625" y2="290.875" stroke="#cbd5e1" stroke-dasharray="4 4"></line><circle cx="475" cy="304.875" r="3" fill="#94a3b8"></circle><text x="485" y="308.875" font-size="12" fill="#475569">Book State</text><circle cx="475" cy="324.875" r="3" fill="#94a3b8"></circle><text x="485" y="328.875" font-size="12" fill="#475569">Book Type</text><circle cx="475" cy="344.875" r="3" fill="#94a3b8"></circle><text x="485" y="348.875" font-size="12" fill="#475569">Library Branch</text><circle cx="475" cy="364.875" r="3" fill="#94a3b8"></circle><text x="485" y="368.875" font-size="12" fill="#475569">Bound To Patron</text></g><g class="d5-aggregate"><rect x="871" y="442.875" width="180" height="126" rx="8" fill="white" stroke="#3b82f6" stroke-width="2"></rect><path d="M871,476.875 L871,450.875 Q871,442.875 879,442.875 L1043,442.875 Q1051,442.875 1051,450.875 L1051,476.875 Z" fill="#dbeafe"></path><line x1="871" y1="476.875" x2="1051" y2="476.875" stroke="#3b82f6" stroke-width="1.5"></line><text x="961" y="462.875" text-anchor="middle" font-size="13" font-weight="bold" fill="#1e293b">Library Branch</text><text x="961" y="496.875" text-anchor="middle" font-size="11" font-style="italic" fill="#3b82f6">Root: Library Branch</text><line x1="881" y1="508.875" x2="1041" y2="508.875" stroke="#cbd5e1" stroke-dasharray="4 4"></line><circle cx="891" cy="522.875" r="3" fill="#94a3b8"></circle><text x="901" y="526.875" font-size="12" fill="#475569">Branch Code</text><circle cx="891" cy="542.875" r="3" fill="#94a3b8"></circle><text x="901" y="546.875" font-size="12" fill="#475569">Name</text></g><g class="d5-read-model"><rect x="871" y="296.375" width="180" height="74" rx="6" fill="white" stroke="#64748b" stroke-width="2"></rect><path d="M871,326.375 L871,302.375 Q871,296.375 877,296.375 L1045,296.375 Q1051,296.375 1051,302.375 L1051,326.375 Z" fill="#f1f5f9"></path><line x1="871" y1="326.375" x2="1051" y2="326.375" stroke="#64748b" stroke-width="1"></line><text x="961" y="315.375" text-anchor="middle" font-size="13" font-weight="bold" fill="#1e293b">Patron Profile</text><text x="961" y="342.375" text-anchor="middle" font-size="10" font-style="italic" fill="#64748b">read model</text><line x1="883" y1="356.375" x2="1039" y2="356.375" stroke="#e2e8f0" stroke-width="1"></line><line x1="883" y1="365.375" x2="1039" y2="365.375" stroke="#e2e8f0" stroke-width="1"></line></g><g class="d5-read-model"><rect x="861" y="162.375" width="200" height="74" rx="6" fill="white" stroke="#64748b" stroke-width="2"></rect><path d="M861,192.375 L861,168.375 Q861,162.375 867,162.375 L1055,162.375 Q1061,162.375 1061,168.375 L1061,192.375 Z" fill="#f1f5f9"></path><line x1="861" y1="192.375" x2="1061" y2="192.375" stroke="#64748b" stroke-width="1"></line><text x="961" y="181.375" text-anchor="middle" font-size="13" font-weight="bold" fill="#1e293b">Expiring Holds Daily Sheet</text><text x="961" y="208.375" text-anchor="middle" font-size="10" font-style="italic" fill="#64748b">read model</text><line x1="873" y1="222.375" x2="1049" y2="222.375" stroke="#e2e8f0" stroke-width="1"></line><line x1="873" y1="231.375" x2="1049" y2="231.375" stroke="#e2e8f0" stroke-width="1"></line></g><g class="d5-rel"><path d="M 240 284.03006329113924 Q 347.5 228.375 401.25 250.0110759493671 L 455 271.6471518987342" fill="none" stroke="#64748b" stroke-width="1.5" marker-end="url(#d5-arrowhead)"></path><g class="d5-edge-label"><rect x="271" y="212.375" width="153" height="32" rx="4" fill="white" fill-opacity="0.92" stroke="#cbd5e1" stroke-width="1"></rect><text x="347.5" y="223.575" text-anchor="middle" font-size="10" font-weight="600" fill="#475569">places holds on &amp; checks out</text><text x="347.5" y="236.575" text-anchor="middle" font-size="10" font-weight="600" fill="#475569">books referenced by book id</text></g></g><g class="d5-rel"><path d="M 635 362.4070197044335 Q 748 430.875 809.5 452.5299295774648 L 871 474.1848591549296" fill="none" stroke="#64748b" stroke-width="1.5" marker-end="url(#d5-arrowhead)"></path><g class="d5-edge-label"><rect x="682.5" y="414.875" width="131" height="32" rx="4" fill="white" fill-opacity="0.92" stroke="#cbd5e1" stroke-width="1"></rect><text x="748" y="426.075" text-anchor="middle" font-size="10" font-weight="600" fill="#475569">is shelved at a branch</text><text x="748" y="439.075" text-anchor="middle" font-size="10" font-weight="600" fill="#475569">referenced by branch id</text></g></g><g class="d5-rel"><path d="M 232.2681883024251 403.625 Q 347.5 505.875 446.25 505.875 Q 545 505.875 646.5 505.875 Q 748 505.875 809.5 505.875 L 871 505.875" fill="none" stroke="#64748b" stroke-width="1.5" marker-end="url(#d5-arrowhead)"></path><g class="d5-edge-label"><rect x="476.5" y="489.875" width="137" height="32" rx="4" fill="white" fill-opacity="0.92" stroke="#cbd5e1" stroke-width="1"></rect><text x="545" y="501.075" text-anchor="middle" font-size="10" font-weight="600" fill="#475569">overdue-checkout limit is</text><text x="545" y="514.075" text-anchor="middle" font-size="10" font-weight="600" fill="#475569">counted per branch id</text></g></g><g class="d5-event"><title>BookPlacedOnHold — emitted by patron_agg, handled by book_agg</title><path d="M 240 304.99208860759495 Q 347.5 274.375 401.25 283.49208860759495 L 455 292.6091772151899" fill="none" stroke="#d97706" stroke-width="1.5" stroke-dasharray="6 4" marker-end="url(#d5-event-arrowhead)"></path><g class="d5-event-label"><path d="M290,265.375 L398,265.375 L405,274.375 L398,283.375 L290,283.375 Z" fill="#fef3c7" stroke="#d97706" stroke-width="1"></path><text x="344" y="277.875" text-anchor="middle" font-size="10" font-weight="600" fill="#92400e">BookPlacedOnHold</text></g></g><g class="d5-event"><title>BookCheckedOut — emitted by patron_agg, handled by book_agg</title><path d="M 240 356.7136075949367 Q 347.5 387.875 401.25 366.1028481012658 L 455 344.3306962025316" fill="none" stroke="#d97706" stroke-width="1.5" stroke-dasharray="6 4" marker-end="url(#d5-event-arrowhead)"></path><g class="d5-event-label"><path d="M295,378.875 L393,378.875 L400,387.875 L393,396.875 L295,396.875 Z" fill="#fef3c7" stroke="#d97706" stroke-width="1"></path><text x="344" y="391.375" text-anchor="middle" font-size="10" font-weight="600" fill="#92400e">BookCheckedOut</text></g></g><g class="d5-event"><title>BookHoldExpired — emitted by book_agg, handled by patron_profile</title><path d="M 635 307.875 Q 748 307.875 809.5 315.23767605633805 L 871 322.6003521126761" fill="none" stroke="#d97706" stroke-width="1.5" stroke-dasharray="6 4" marker-end="url(#d5-event-arrowhead)"></path><g class="d5-event-label"><path d="M694,298.875 L795,298.875 L802,307.875 L795,316.875 L694,316.875 Z" fill="#fef3c7" stroke="#d97706" stroke-width="1"></path><text x="744.5" y="311.375" text-anchor="middle" font-size="10" font-weight="600" fill="#92400e">BookHoldExpired</text></g></g><g class="d5-event"><title>BookCheckedOut — emitted by book_agg, handled by patron_profile</title><path d="M 635 342.0129310344828 Q 748 384.875 809.5 370.00528169014086 L 871 355.1355633802817" fill="none" stroke="#d97706" stroke-width="1.5" stroke-dasharray="6 4" marker-end="url(#d5-event-arrowhead)"></path><g class="d5-event-label"><path d="M695.5,375.875 L793.5,375.875 L800.5,384.875 L793.5,393.875 L695.5,393.875 Z" fill="#fef3c7" stroke="#d97706" stroke-width="1"></path><text x="744.5" y="388.375" text-anchor="middle" font-size="10" font-weight="600" fill="#92400e">BookCheckedOut</text></g></g><g class="d5-event"><title>BookPlacedOnHold — emitted by book_agg, handled by daily_sheet</title><path d="M 635 245.4735221674877 Q 748 167.125 804.5 175.67957746478874 L 861 184.23415492957747" fill="none" stroke="#d97706" stroke-width="1.5" stroke-dasharray="6 4" marker-end="url(#d5-event-arrowhead)"></path><g class="d5-event-label"><path d="M690.5,158.125 L798.5,158.125 L805.5,167.125 L798.5,176.125 L690.5,176.125 Z" fill="#fef3c7" stroke="#d97706" stroke-width="1"></path><text x="744.5" y="170.625" text-anchor="middle" font-size="10" font-weight="600" fill="#92400e">BookPlacedOnHold</text></g></g><g class="d5-policy"><title>Policy — triggered via book_agg, acts on patron_agg</title><path d="M 455 368.7104430379747 Q 347.5 441.375 293.75 411.2341772151899 L 240 381.09335443037975" fill="none" stroke="#7c3aed" stroke-width="1.5" stroke-dasharray="3 3" marker-end="url(#d5-policy-arrowhead)"></path><g class="d5-policy-label"><rect x="270" y="417.875" width="155" height="47" rx="4" fill="#ede9fe" stroke="#7c3aed" stroke-width="1"></rect><text x="347.5" y="430.075" text-anchor="middle" font-size="10" font-weight="600" fill="#5b21b6">when a book is checked out,</text><text x="347.5" y="443.075" text-anchor="middle" font-size="10" font-weight="600" fill="#5b21b6">complete the patron's</text><text x="347.5" y="456.075" text-anchor="middle" font-size="10" font-weight="600" fill="#5b21b6">open-ended hold on it</text></g></g><g class="d5-policy"><title>Policy — triggered via daily_sheet, acts on book_agg</title><path d="M 861 215.68955399061034 Q 748 234.125 691.5 254.6514778325123 L 635 275.1779556650246" fill="none" stroke="#7c3aed" stroke-width="1.5" stroke-dasharray="3 3" marker-end="url(#d5-policy-arrowhead)"></path><g class="d5-policy-label"><rect x="665" y="210.625" width="166" height="47" rx="4" fill="#ede9fe" stroke="#7c3aed" stroke-width="1"></rect><text x="748" y="222.825" text-anchor="middle" font-size="10" font-weight="600" fill="#5b21b6">each day: expire any</text><text x="748" y="235.825" text-anchor="middle" font-size="10" font-weight="600" fill="#5b21b6">closed-ended hold on the sheet</text><text x="748" y="248.825" text-anchor="middle" font-size="10" font-weight="600" fill="#5b21b6">not yet checked out</text></g></g>"`;

exports[`examples render regression > ddd-by-examples-library/domain.md > matches SVG snapshot 1`] = `"<defs><marker id="d5-arrowhead" markerWidth="8" markerHeight="8" refX="8" refY="4" orient="auto"><path d="M0,0 L8,4 L0,8" fill="#64748b"></path></marker></defs><text class="d5-title" x="569" y="24" text-anchor="middle" font-size="18" font-weight="bold" fill="#1e293b">Public Library — Domain</text><g class="d5-domain"><rect x="30" y="70" width="1078" height="235" rx="12" fill="#f8fafc" stroke="#94a3b8" stroke-width="2" stroke-dasharray="8 4"></rect><text x="46" y="94" font-size="14" font-weight="600" fill="#475569">Public Library</text></g><g class="d5-subdomain d5-subdomain-core"><rect x="60" y="161" width="180" height="70" rx="8" fill="#dbeafe" stroke="#3b82f6" stroke-width="2"></rect><text x="150" y="192" text-anchor="middle" font-size="13" font-weight="600" fill="#1e293b">Book Circulation</text><text x="150" y="212" text-anchor="middle" font-size="11" fill="#3b82f6">core</text></g><g class="d5-subdomain d5-subdomain-supporting"><rect x="488" y="205" width="180" height="70" rx="8" fill="#fef9c3" stroke="#ca8a04" stroke-width="2"></rect><text x="578" y="236" text-anchor="middle" font-size="13" font-weight="600" fill="#1e293b">Book Catalogue</text><text x="578" y="256" text-anchor="middle" font-size="11" fill="#ca8a04">supporting</text></g><g class="d5-subdomain d5-subdomain-generic"><rect x="898" y="161" width="180" height="70" rx="8" fill="#e5e7eb" stroke="#6b7280" stroke-width="2"></rect><text x="988" y="192" text-anchor="middle" font-size="13" font-weight="600" fill="#1e293b">Library Branches</text><text x="988" y="212" text-anchor="middle" font-size="11" fill="#6b7280">generic</text></g><g class="d5-rel"><path d="M 240 214.50467289719626 Q 364 240 426 240 L 488 240" fill="none" stroke="#64748b" stroke-width="1.5" marker-end="url(#d5-arrowhead)"></path><g class="d5-edge-label"><rect x="286" y="224" width="156" height="32" rx="4" fill="white" fill-opacity="0.92"