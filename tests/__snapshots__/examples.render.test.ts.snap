exports[`examples render regression > vernon-iddd-samples/aggregate-backlog-item.md > matches SVG snapshot 1`] = `"<text class="d5-title" x="531.5" y="24" text-anchor="middle" font-size="18" font-weight="bold" fill="#1e293b">Backlog Item Aggregate</text><g class="d5-aggregate"><rect x="30" y="70" width="1003" height="484" rx="12" fill="#f8fafc" stroke="#94a3b8" stroke-width="2" stroke-dasharray="8 4"></rect><text x="46" y="94" font-size="14" font-weight="600" fill="#475569">Aggregate: Backlog Item</text></g><g class="d5-entity d5-aggregate-root"><rect x="58" y="134" width="947" height="58" rx="8" fill="#eff6ff" stroke="#3b82f6" stroke-width="3"></rect><text x="531.5" y="159" text-anchor="middle" font-size="15" font-weight="bold" fill="#1e293b">Backlog Item</text><text x="531.5" y="177" text-anchor="middle" font-size="10" font-style="italic" fill="#3b82f6">Aggregate Root</text></g><g class="d5-entity"><rect x="58" y="216" width="175" height="49" rx="6" fill="white" stroke="#3b82f6" stroke-width="2"></rect><text x="145.5" y="236.05" text-anchor="middle" font-size="13" font-weight="600" fill="#1e293b">Task</text><text x="145.5" y="255.05" text-anchor="middle" font-size="10" font-style="italic" fill="#3b82f6">Entity</text></g><g class="d5-value-object"><rect x="251" y="216" width="175" height="49" rx="24.5" fill="white" stroke="#10b981" stroke-width="2"></rect><text x="338.5" y="236.05" text-anchor="middle" font-size="13" font-weight="600" fill="#1e293b">Backlog Item ID</text><text x="338.5" y="255.05" text-anchor="middle" font-size="10" font-style="italic" fill="#10b981">Value Object</text></g><g class="d5-value-object"><rect x="444" y="216" width="175" height="49" rx="24.5" fill="white" stroke="#10b981" stroke-width="2"></rect><text x="531.5" y="236.05" text-anchor="middle" font-size="13" font-weight="600" fill="#1e293b">Story</text><text x="531.5" y="255.05" text-anchor="middle" font-size="10" font-style="italic" fill="#10b981">Value Object</text></g><g class="d5-value-object"><rect x="637" y="216" width="175" height="49" rx="24.5" fill="white" stroke="#10b981" stroke-width="2"></rect><text x="724.5" y="236.05" text-anchor="middle" font-size="13" font-weight="600" fill="#1e293b">Backlog Item Type</text><text x="724.5" y="255.05" text-anchor="middle" font-size="10" font-style="italic" fill="#10b981">Value Object</text></g><g class="d5-value-object"><rect x="830" y="216" width="175" height="49" rx="24.5" fill="white" stroke="#10b981" stroke-width="2"></rect><text x="917.5" y="236.05" text-anchor="middle" font-size="13" font-weight="600" fill="#1e293b">Backlog Item Status</text><text x="917.5" y="255.05" text-anchor="middle" font-size="10" font-style="italic" fill="#10b981">Value Object</text></g><g class="d5-value-object"><rect x="58" y="283" width="175" height="49" rx="24.5" fill="white" stroke="#10b981" stroke-width="2"></rect><text x="145.5" y="303.05" text-anchor="middle" font-size="13" font-weight="600" fill="#1e293b">Story Points</text><text x="145.5" y="322.05" text-anchor="middle" font-size="10" font-style="italic" fill="#10b981">Value Object</text></g><g class="d5-value-object"><rect x="251" y="283" width="175" height="49" rx="24.5" fill="white" stroke="#10b981" stroke-width="2"></rect><text x="338.5" y="303.05" text-anchor="middle" font-size="13" font-weight="600" fill="#1e293b">Committed Sprint</text><text x="338.5" y="322.05" text-anchor="middle" font-size="10" font-style="italic" fill="#10b981">Value Object</text></g><g class="d5-value-object"><rect x="444" y="283" width="175" height="49" rx="24.5" fill="white" stroke="#10b981" stroke-width="2"></rect><text x="531.5" y="303.05" text-anchor="middle" font-size="13" font-weight="600" fill="#1e293b">Task Hours Log Entry</text><text x="531.5" y="322.05" text-anchor="middle" font-size="10" font-style="italic" fill="#10b981">Value Object</text></g><g class="d5-invariants"><rect x="38" y="342" width="987" height="184" rx="6" fill="#fffbeb" stroke="#fcd34d" stroke-width="1" stroke-dasharray="4 3"></rect><text x="46" y="364.8" font-size="12" font-weight="bold" fill="#92400e">Invariants — enforced by root: Backlog Item</text><rect x="47" y="376" width="6" height="6" transform="rotate(45 50 379)" fill="#f59e0b"></rect><text x="62" y="382" font-size="12" fill="#78350f">A backlog item may be committed to at most one sprint at any given time</text><rect x="47" y="401" width="6" height="6" transform="rotate(45 50 404)" fill="#f59e0b"></rect><text x="62" y="407" font-size="12" fill="#78350f">A backlog item can be committed to a sprint only after it has been scheduled into a release</text><rect x="47" y="426" width="6" height="6" transform="rotate(45 50 429)" fill="#f59e0b"></rect><text x="62" y="432" font-size="12" fill="#78350f">Status — It is marked Done only once every one of its tasks reports zero hours remaining</text><rect x="47" y="451" width="6" height="6" transform="rotate(45 50 454)" fill="#f59e0b"></rect><text x="62" y="457" font-size="12" fill="#78350f">Re-estimating a committed backlog item's story points to zero automatically uncommits it from its</text><text x="62" y="473" font-size="12" fill="#78350f">sprint</text><rect x="47" y="492" width="6" height="6" transform="rotate(45 50 495)" fill="#f59e0b"></rect><text x="62" y="498" font-size="12" fill="#78350f">Task hours-remaining is kept as an append-only log; the current estimate is the most recent entry</text></g><g class="d5-legend"><rect x="30" y="570" width="14" height="14" rx="3" fill="white" stroke="#3b82f6" stroke-width="3"></rect><text x="50" y="581" font-size="11" fill="#64748b">Aggregate Root</text><rect x="156.43000000000004" y="570" width="14" height="14" rx="3" fill="white" stroke="#3b82f6" stroke-width="2"></rect><text x="176.43000000000004" y="581" font-size="11" fill="#64748b">Entity</text><rect x="234.35000000000002" y="570" width="14" height="14" rx="7" fill="white" stroke="#10b981" stroke-width="2"></rect><text x="254.35000000000002" y="581" font-size="11" fill="#64748b">Value Object</text></g>"`;

exports[`examples render regression > vernon-iddd-samples/aggregate-product.md > matches SVG snapshot 1`] = `"<text class="d5-title" x="481.5" y="24" text-anchor="middle" font-size="18" font-weight="bold" fill="#1e293b">Product Aggregate</text><g class="d5-aggregate"><rect x="30" y="70" width="903" height="367" rx="12" fill="#f8fafc" stroke="#94a3b8" stroke-width="2" stroke-dasharray="8 4"></rect><text x="46" y="94" font-size="14" font-weight="600" fill="#475569">Aggregate: Product</text></g><g class="d5-entity d5-aggregate-root"><rect x="58" y="134" width="847" height="58" rx="8" fill="#eff6ff" stroke="#3b82f6" stroke-width="3"></rect><text x="481.5" y="159" text-anchor="middle" font-size="15" font-weight="bold" fill="#1e293b">Product</text><text x="481.5" y="177" text-anchor="middle" font-size="10" font-style="italic" fill="#3b82f6">Aggregate Root</text></g><g class="d5-value-object"><rect x="58" y="216" width="155" height="49" rx="24.5" fill="white" stroke="#10b981" stroke-width="2"></rect><text x="135.5" y="236.05" text-anchor="middle" font-size="13" font-weight="600" fill="#1e293b">Product ID</text><text x="135.5" y="255.05" text-anchor="middle" font-size="10" font-style="italic" fill="#10b981">Value Object</text></g><g class="d5-value-object"><rect x="231" y="216" width="155" height="49" rx="24.5" fill="white" stroke="#10b981" stroke-width="2"></rect><text x="308.5" y="236.05" text-anchor="middle" font-size="13" font-weight="600" fill="#1e293b">Product Owner</text><text x="308.5" y="255.05" text-anchor="middle" font-size="10" font-style="italic" fill="#10b981">Value Object</text></g><g class="d5-value-object"><rect x="404" y="216" width="155" height="49" rx="24.5" fill="white" stroke="#10b981" stroke-width="2"></rect><text x="481.5" y="236.05" text-anchor="middle" font-size="13" font-weight="600" fill="#1e293b">Name</text><text x="481.5" y="255.05" text-anchor="middle" font-size="10" font-style="italic" fill="#10b981">Value Object</text></g><g class="d5-value-object"><rect x="577" y="216" width="155" height="49" rx="24.5" fill="white" stroke="#10b981" stroke-width="2"></rect><text x="654.5" y="236.05" text-anchor="middle" font-size="13" font-weight="600" fill="#1e293b">Description</text><text x="654.5" y="255.05" text-anchor="middle" font-size="10" font-style="italic" fill="#10b981">Value Object</text></g><g class="d5-value-object"><rect x="750" y="216" width="155" height="49" rx="24.5" fill="white" stroke="#10b981" stroke-width="2"></rect><text x="827.5" y="236.05" text-anchor="middle" font-size="13" font-weight="600" fill="#1e293b">Product Discussion</text><text x="827.5" y="255.05" text-anchor="middle" font-size="10" font-style="italic" fill="#10b981">Value Object</text></g><g class="d5-invariants"><rect x="38" y="275" width="887" height="134" rx="6" fill="#fffbeb" stroke="#fcd34d" stroke-width="1" stroke-dasharray="4 3"></rect><text x="46" y="297.8" font-size="12" font-weight="bold" fill="#92400e">Invariants — enforced by root: Product</text><rect x="47" y="309" width="6" height="6" transform="rotate(45 50 312)" fill="#f59e0b"></rect><text x="62" y="315" font-size="12" fill="#78350f">A product always has exactly one product owner</text><rect x="47" y="334" width="6" height="6" transform="rotate(45 50 337)" fill="#f59e0b"></rect><text x="62" y="340" font-size="12" fill="#78350f">Discussion — When collaboration is enabled the product holds a reference to its discussion; until then</text><text x="62" y="356" font-size="12" fill="#78350f">the discussion is only 'requested' and is attached asynchronously</text><rect x="47" y="375" width="6" height="6" transform="rotate(45 50 378)" fill="#f59e0b"></rect><text x="62" y="381" font-size="12" fill="#78350f">Backlog items, releases and sprints are only ever created in the context of their owning product</text></g><g class="d5-legend"><rect x="30" y="453" width="14" height="14" rx="3" fill="white" stroke="#3b82f6" stroke-width="3"></rect><text x="50" y="464" font-size="11" fill="#64748b">Aggregate Root</text><rect x="156.43000000000004" y="453" width="14" height="14" rx="3" fill="white" stroke="#3b82f6" stroke-width="2"></rect><text x="176.43000000000004" y="464" font-size="11" fill="#64748b">Entity</text><rect x="234.35000000000002" y="453" width="14" height="14" rx="7" fill="white" stroke="#10b981" stroke-width="2"></rect><text x="254.35000000000002" y="464" font-size="11" fill="#64748b">Value Object</text></g>"`;

exports[`examples render regression > vernon-iddd-samples/aggregate-sprint.md > matches SVG snapshot 1`] = `"<text class="d5-title" x="459" y="24" text-anchor="middle" font-size="18" font-weight="bold" fill="#1e293b">Sprint Aggregate</text><g class="d5-aggregate"><rect x="30" y="70" width="858" height="367" rx="12" fill="#f8fafc" stroke="#94a3b8" stroke-width="2" stroke-dasharray="8 4"></rect><text x="46" y="94" font-size="14" font-weight="600" fill="#475569">Aggregate: Sprint</text></g><g class="d5-entity d5-aggregate-root"><rect x="58" y="134" width="802" height="58" rx="8" fill="#eff6ff" stroke="#3b82f6" stroke-width="3"></rect><text x="459" y="159" text-anchor="middle" font-size="15" font-weight="bold" fill="#1e293b">Sprint</text><text x="459" y="177" text-anchor="middle" font-size="10" font-style="italic" fill="#3b82f6">Aggregate Root</text></g><g class="d5-value-object"><rect x="58" y="216" width="187" height="49" rx="24.5" fill="white" stroke="#10b981" stroke-width="2"></rect><text x="151.5" y="236.05" text-anchor="middle" font-size="13" font-weight="600" fill="#1e293b">Sprint ID</text><text x="151.5" y="255.05" text-anchor="middle" font-size="10" font-style="italic" fill="#10b981">Value Object</text></g><g class="d5-value-object"><rect x="263" y="216" width="187" height="49" rx="24.5" fill="white" stroke="#10b981" stroke-width="2"></rect><text x="356.5" y="236.05" text-anchor="middle" font-size="13" font-weight="600" fill="#1e293b">Sprint Goals</text><text x="356.5" y="255.05" text-anchor="middle" font-size="10" font-style="italic" fill="#10b981">Value Object</text></g><g class="d5-value-object"><rect x="468" y="216" width="187" height="49" rx="24.5" fill="white" stroke="#10b981" stroke-width="2"></rect><text x="561.5" y="236.05" text-anchor="middle" font-size="13" font-weight="600" fill="#1e293b">Date Range</text><text x="561.5" y="255.05" text-anchor="middle" font-size="10" font-style="italic" fill="#10b981">Value Object</text></g><g class="d5-value-object"><rect x="673" y="216" width="187" height="49" rx="24.5" fill="white" stroke="#10b981" stroke-width="2"></rect><text x="766.5" y="236.05" text-anchor="middle" font-size="13" font-weight="600" fill="#1e293b">Committed Backlog Item</text><text x="766.5" y="255.05" text-anchor="middle" font-size="10" font-style="italic" fill="#10b981">Value Object</text></g><g class="d5-invariants"><rect x="38" y="275" width="842" height="134" rx="6" fill="#fffbeb" stroke="#fcd34d" stroke-width="1" stroke-dasharray="4 3"></rect><text x="46" y="297.8" font-size="12" font-weight="bold" fill="#92400e">Invariants — enforced by root: Sprint</text><rect x="47" y="309" width="6" height="6" transform="rotate(45 50 312)" fill="#f59e0b"></rect><text x="62" y="315" font-size="12" fill="#78350f">A sprint's end date must fall after its begin date</text><rect x="47" y="334" width="6" height="6" transform="rotate(45 50 337)" fill="#f59e0b"></rect><text x="62" y="340" font-size="12" fill="#78350f">Only a backlog item already scheduled into a release may be committed to a sprint</text><rect x="47" y="359" width="6" height="6" transform="rotate(45 50 362)" fill="#f59e0b"></rect><text x="62" y="365" font-size="12" fill="#78350f">Committing a backlog item that is already committed elsewhere first uncommits it from the other</text><text x="62" y="381" font-size="12" fill="#78350f">sprint</text></g><g class="d5-legend"><rect x="30" y="453" width="14" height="14" rx="3" fill="white" stroke="#3b82f6" stroke-width="3"></rect><text x="50" y="464" font-size="11" fill="#64748b">Aggregate Root</text><rect x="156.43000000000004" y="453" width="14" height="14" rx="3" fill="white" stroke="#3b82f6" stroke-width="2"></rect><text x="176.43000000000004" y="464" font-size="11" fill="#64748b">Entity</text><rect x="234.35000000000002" y="453" width="14" height="14" rx="7" fill="white" stroke="#10b981" stroke-width="2"></rect><text x="254.35000000000002" y="464" font-size="11" fill="#64748b">Value Object</text></g>"`;

exports[`examples render regression > vernon-iddd-samples/context-agile-pm.md > matches SVG snapshot 1`] = `"<defs><marker id="d5-arrowhead" markerWidth="8" markerHeight="8" refX="8" refY="4" orient="auto"><path d="M0,0 L8,4 L0,8" fill="#64748b"></path></marker><marker id="d5-event-arrowhead" markerWidth="8" markerHeight="8" refX="8" refY="4" orient="auto"><path d="M0,0 L8,4 L0,8" fill="#d97706"></path></marker><marker id="d5-policy-arrowhead" markerWidth="8" markerHeight="8" refX="8" refY="4" orient="auto"><path d="M0,0 L8,4 L0,8" fill="#7c3aed"></path></marker></defs><text class="d5-title" x="1317.5" y="24" text-anchor="middle" font-size="18" font-weight="bold" fill="#1e293b">Agile PM Context — Tactical Structure</text><g class="d5-bounded-context"><rect x="30" y="64" width="2575" height="576" rx="12" fill="#f8fafc" stroke="#94a3b8" stroke-width="2" stroke-dasharray="8 4"></rect><text x="46" y="88" font-size="14" font-weight="600" fill="#475569">Agile PM</text><text x="2589" y="88" font-size="12" font-style="italic" fill="#64748b" text-anchor="end">Team: ProjectOvation Team</text></g><g class="d5-language-note"><rect x="2247" y="130" width="328" height="480" rx="4" fill="#fef9c3" stroke="#ca8a04" stroke-width="1.5"></rect><path d="M2247,160 L2247,134 Q2247,130 2251,130 L2571,130 Q2575,130 2575,134 L2575,160 Z" fill="#fde047"></path><text x="2411" y="150" text-anchor="middle" font-size="12" font-weight="bold" fill="#854d0e">Ubiquitous Language</text><text x="2261" y="184.2" font-size="12" font-weight="bold" fill="#713f12">Product:</text><text x="2261" y="202.2" font-size="11" fill="#854d0e">The overarching thing a team is building; it owns the</text><text x="2261" y="216.2" font-size="11" fill="#854d0e">product backlog and every release and sprint planned</text><text x="2261" y="230.2" font-size="11" fill="#854d0e">against it</text><text x="2261" y="256.2" font-size="12" font-weight="bold" fill="#713f12">Backlog Item:</text><text x="2261" y="274.2" font-size="11" fill="#854d0e">One planned unit of work on a product backlog — a story</text><text x="2261" y="288.2" font-size="11" fill="#854d0e">with a type, a status, a story-point estimate and a set of</text><text x="2261" y="302.2" font-size="11" fill="#854d0e">tasks</text><text x="2261" y="328.2" font-size="12" font-weight="bold" fill="#713f12">Task:</text><text x="2261" y="346.2" font-size="11" fill="#854d0e">A concrete piece of work inside a backlog item, tracked</text><text x="2261" y="360.2" font-size="11" fill="#854d0e">by the hours estimated to remain until it is done</text><text x="2261" y="386.2" font-size="12" font-weight="bold" fill="#713f12">Sprint:</text><text x="2261" y="404.2" font-size="11" fill="#854d0e">A fixed time-box in which a team commits to completing a</text><text x="2261" y="418.2" font-size="11" fill="#854d0e">selected set of backlog items</text><text x="2261" y="444.2" font-size="12" font-weight="bold" fill="#713f12">Release:</text><text x="2261" y="462.2" font-size="11" fill="#854d0e">A named future point by which a selected set of backlog</text><text x="2261" y="476.2" font-size="11" fill="#854d0e">items is intended to ship</text><text x="2261" y="502.2" font-size="12" font-weight="bold" fill="#713f12">Story Points:</text><text x="2261" y="520.2" font-size="11" fill="#854d0e">A team's relative estimate of a backlog item's size —</text><text x="2261" y="534.2" font-size="11" fill="#854d0e">deliberately not a time estimate</text><text x="2261" y="560.2" font-size="12" font-weight="bold" fill="#713f12">Product Owner:</text><text x="2261" y="578.2" font-size="11" fill="#854d0e">The single person accountable for the content and</text><text x="2261" y="592.2" font-size="11" fill="#854d0e">ordering of the product backlog</text></g><g class="d5-aggregate"><rect x="425" y="239" width="180" height="166" rx="8" fill="white" stroke="#3b82f6" stroke-width="2"></rect><path d="M425,273 L425,247 Q425,239 433,239 L597,239 Q605,239 605,247 L605,273 Z" fill="#dbeafe"></path><line x1="425" y1="273" x2="605" y2="273" stroke="#3b82f6" stroke-width="1.5"></line><text x="515" y="259" text-anchor="middle" font-size="13" font-weight="bold" fill="#1e293b">Product</text><text x="515" y="293" text-anchor="middle" font-size="11" font-style="italic" fill="#3b82f6">Root: Product</text><line x1="435" y1="305" x2="595" y2="305" stroke="#cbd5e1" stroke-dasharray="4 4"></line><circle cx="445" cy="319" r="3" fill="#94a3b8"></circle><text x="455" y="323" font-size="12" fill="#475569">Product Owner</text><circle cx="445" cy="339" r="3" fill="#94a3b8"></circle><text x="455" y="343" font-size="12" fill="#475569">Backlog Items</text><circle cx="445" cy="359" r="3" fill="#94a3b8"></circle><text x="455" y="363" font-size="12" fill="#475569">Planned Releases</text><circle cx="445" cy="379" r="3" fill="#94a3b8"></circle><text x="455" y="383" font-size="12" fill="#475569">Scheduled Sprints</text></g><g class="d5-aggregate"><rect x="1213" y="298.5" width="180" height="186" rx="8" fill="white" stroke="#3b82f6" stroke-width="2"></rect><path d="M1213,332.5 L1213,306.5 Q1213,298.5 1221,298.5 L1385,298.5 Q1393,298.5 1393,306.5 L1393,332.5 Z" fill="#dbeafe"></path><line x1="1213" y1="332.5" x2="1393" y2="332.5" stroke="#3b82f6" stroke-width="1.5"></line><text x="1303" y="318.5" text-anchor="middle" font-size="13" font-weight="bold" fill="#1e293b">Backlog Item</text><text x="1303" y="352.5" text-anchor="middle" font-size="11" font-style="italic" fill="#3b82f6">Root: Backlog Item</text><line x1="1223" y1="364.5" x2="1383" y2="364.5" stroke="#cbd5e1" stroke-dasharray="4 4"></line><circle cx="1233" cy="378.5" r="3" fill="#94a3b8"></circle><text x="1243" y="382.5" font-size="12" fill="#475569">Story</text><circle cx="1233" cy="398.5" r="3" fill="#94a3b8"></circle><text x="1243" y="402.5" font-size="12" fill="#475569">Type</text><circle cx="1233" cy="418.5" r="3" fill="#94a3b8"></circle><text x="1243" y="422.5" font-size="12" fill="#475569">Status</text><circle cx="1