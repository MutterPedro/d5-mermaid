exports[`examples render regression > nick-tune-core-domain-chart/aggregate-price-rule.md > matches SVG snapshot 1`] = `"<text class="d5-title" x="469" y="24" text-anchor="middle" font-size="18" font-weight="bold" fill="#1e293b">Price Rule Aggregate</text><g class="d5-aggregate"><rect x="30" y="70" width="878" height="459" rx="12" fill="#f8fafc" stroke="#94a3b8" stroke-width="2" stroke-dasharray="8 4"></rect><text x="46" y="94" font-size="14" font-weight="600" fill="#475569">Aggregate: Price Rule</text></g><g class="d5-entity d5-aggregate-root"><rect x="58" y="134" width="822" height="58" rx="8" fill="#eff6ff" stroke="#3b82f6" stroke-width="3"></rect><text x="469" y="159" text-anchor="middle" font-size="15" font-weight="bold" fill="#1e293b">Price Rule</text><text x="469" y="177" text-anchor="middle" font-size="10" font-style="italic" fill="#3b82f6">Aggregate Root</text></g><g class="d5-value-object"><rect x="58" y="216" width="150" height="49" rx="24.5" fill="white" stroke="#10b981" stroke-width="2"></rect><text x="133" y="236.05" text-anchor="middle" font-size="13" font-weight="600" fill="#1e293b">Rule ID</text><text x="133" y="255.05" text-anchor="middle" font-size="10" font-style="italic" fill="#10b981">Value Object</text></g><g class="d5-value-object"><rect x="226" y="216" width="150" height="49" rx="24.5" fill="white" stroke="#10b981" stroke-width="2"></rect><text x="301" y="236.05" text-anchor="middle" font-size="13" font-weight="600" fill="#1e293b">Scope</text><text x="301" y="255.05" text-anchor="middle" font-size="10" font-style="italic" fill="#10b981">Value Object</text></g><g class="d5-value-object"><rect x="394" y="216" width="150" height="49" rx="24.5" fill="white" stroke="#10b981" stroke-width="2"></rect><text x="469" y="236.05" text-anchor="middle" font-size="13" font-weight="600" fill="#1e293b">Pricing Formula</text><text x="469" y="255.05" text-anchor="middle" font-size="10" font-style="italic" fill="#10b981">Value Object</text></g><g class="d5-value-object"><rect x="562" y="216" width="150" height="49" rx="24.5" fill="white" stroke="#10b981" stroke-width="2"></rect><text x="637" y="236.05" text-anchor="middle" font-size="13" font-weight="600" fill="#1e293b">Priority</text><text x="637" y="255.05" text-anchor="middle" font-size="10" font-style="italic" fill="#10b981">Value Object</text></g><g class="d5-value-object"><rect x="730" y="216" width="150" height="49" rx="24.5" fill="white" stroke="#10b981" stroke-width="2"></rect><text x="805" y="236.05" text-anchor="middle" font-size="13" font-weight="600" fill="#1e293b">Active Window</text><text x="805" y="255.05" text-anchor="middle" font-size="10" font-style="italic" fill="#10b981">Value Object</text></g><g class="d5-value-object"><rect x="58" y="283" width="150" height="49" rx="24.5" fill="white" stroke="#10b981" stroke-width="2"></rect><text x="133" y="303.05" text-anchor="middle" font-size="13" font-weight="600" fill="#1e293b">Base Currency</text><text x="133" y="322.05" text-anchor="middle" font-size="10" font-style="italic" fill="#10b981">Value Object</text></g><g class="d5-invariants"><rect x="38" y="342" width="862" height="159" rx="6" fill="#fffbeb" stroke="#fcd34d" stroke-width="1" stroke-dasharray="4 3"></rect><text x="46" y="364.8" font-size="12" font-weight="bold" fill="#92400e">Invariants — enforced by root: Price Rule</text><rect x="47" y="376" width="6" height="6" transform="rotate(45 50 379)" fill="#f59e0b"></rect><text x="62" y="382" font-size="12" fill="#78350f">Exactly one base price rule is in force for any SKU at any moment — the highest-priority active rule</text><text x="62" y="398" font-size="12" fill="#78350f">whose scope matches</text><rect x="47" y="417" width="6" height="6" transform="rotate(45 50 420)" fill="#f59e0b"></rect><text x="62" y="423" font-size="12" fill="#78350f">A rule's active window starts no later than it ends</text><rect x="47" y="442" width="6" height="6" transform="rotate(45 50 445)" fill="#f59e0b"></rect><text x="62" y="448" font-size="12" fill="#78350f">Priority — Ties in priority are broken by the most specific scope: SKU beats brand beats category</text><rect x="47" y="467" width="6" height="6" transform="rotate(45 50 470)" fill="#f59e0b"></rect><text x="62" y="473" font-size="12" fill="#78350f">The formula result is floored at zero — a rule can never produce a negative effective price</text></g><g class="d5-legend"><rect x="30" y="545" width="14" height="14" rx="3" fill="white" stroke="#3b82f6" stroke-width="3"></rect><text x="50" y="556" font-size="11" fill="#64748b">Aggregate Root</text><rect x="156.43000000000004" y="545" width="14" height="14" rx="3" fill="white" stroke="#3b82f6" stroke-width="2"></rect><text x="176.43000000000004" y="556" font-size="11" fill="#64748b">Entity</text><rect x="234.35000000000002" y="545" width="14" height="14" rx="7" fill="white" stroke="#10b981" stroke-width="2"></rect><text x="254.35000000000002" y="556" font-size="11" fill="#64748b">Value Object</text></g>"`;

exports[`examples render regression > nick-tune-core-domain-chart/aggregate-promotion.md > matches SVG snapshot 1`] = `"<text class="d5-title" x="476.5" y="24" text-anchor="middle" font-size="18" font-weight="bold" fill="#1e293b">Promotion Aggregate</text><g class="d5-aggregate"><rect x="30" y="70" width="893" height="475" rx="12" fill="#f8fafc" stroke="#94a3b8" stroke-width="2" stroke-dasharray="8 4"></rect><text x="46" y="94" font-size="14" font-weight="600" fill="#475569">Aggregate: Promotion</text></g><g class="d5-entity d5-aggregate-root"><rect x="58" y="134" width="837" height="58" rx="8" fill="#eff6ff" stroke="#3b82f6" stroke-width="3"></rect><text x="476.5" y="159" text-anchor="middle" font-size="15" font-weight="bold" fill="#1e293b">Promotion</text><text x="476.5" y="177" text-anchor="middle" font-size="10" font-style="italic" fill="#3b82f6">Aggregate Root</text></g><g class="d5-entity"><rect x="58" y="216" width="153" height="49" rx="6" fill="white" stroke="#3b82f6" stroke-width="2"></rect><text x="134.5" y="236.05" text-anchor="middle" font-size="13" font-weight="600" fill="#1e293b">Redemption</text><text x="134.5" y="255.05" text-anchor="middle" font-size="10" font-style="italic" fill="#3b82f6">Entity</text></g><g class="d5-value-object"><rect x="229" y="216" width="153" height="49" rx="24.5" fill="white" stroke="#10b981" stroke-width="2"></rect><text x="305.5" y="236.05" text-anchor="middle" font-size="13" font-weight="600" fill="#1e293b">Promotion ID</text><text x="305.5" y="255.05" text-anchor="middle" font-size="10" font-style="italic" fill="#10b981">Value Object</text></g><g class="d5-value-object"><rect x="400" y="216" width="153" height="49" rx="24.5" fill="white" stroke="#10b981" stroke-width="2"></rect><text x="476.5" y="236.05" text-anchor="middle" font-size="13" font-weight="600" fill="#1e293b">Promo Code</text><text x="476.5" y="255.05" text-anchor="middle" font-size="10" font-style="italic" fill="#10b981">Value Object</text></g><g class="d5-value-object"><rect x="571" y="216" width="153" height="49" rx="24.5" fill="white" stroke="#10b981" stroke-width="2"></rect><text x="647.5" y="236.05" text-anchor="middle" font-size="13" font-weight="600" fill="#1e293b">Discount</text><text x="647.5" y="255.05" text-anchor="middle" font-size="10" font-style="italic" fill="#10b981">Value Object</text></g><g class="d5-value-object"><rect x="742" y="216" width="153" height="49" rx="24.5" fill="white" stroke="#10b981" stroke-width="2"></rect><text x="818.5" y="236.05" text-anchor="middle" font-size="13" font-weight="600" fill="#1e293b">Conditions</text><text x="818.5" y="255.05" text-anchor="middle" font-size="10" font-style="italic" fill="#10b981">Value Object</text></g><g class="d5-value-object"><rect x="58" y="283" width="153" height="49" rx="24.5" fill="white" stroke="#10b981" stroke-width="2"></rect><text x="134.5" y="303.05" text-anchor="middle" font-size="13" font-weight="600" fill="#1e293b">Redemption Budget</text><text x="134.5" y="322.05" text-anchor="middle" font-size="10" font-style="italic" fill="#10b981">Value Object</text></g><g class="d5-value-object"><rect x="229" y="283" width="153" height="49" rx="24.5" fill="white" stroke="#10b981" stroke-width="2"></rect><text x="305.5" y="303.05" text-anchor="middle" font-size="13" font-weight="600" fill="#1e293b">Redemption Count</text><text x="305.5" y="322.05" text-anchor="middle" font-size="10" font-style="italic" fill="#10b981">Value Object</text></g><g class="d5-value-object"><rect x="400" y="283" width="153" height="49" rx="24.5" fill="white" stroke="#10b981" stroke-width="2"></rect><text x="476.5" y="303.05" text-anchor="middle" font-size="13" font-weight="600" fill="#1e293b">Valid Window</text><text x="476.5" y="322.05" text-anchor="middle" font-size="10" font-style="italic" fill="#10b981">Value Object</text></g><g class="d5-invariants"><rect x="38" y="342" width="877" height="175" rx="6" fill="#fffbeb" stroke="#fcd34d" stroke-width="1" stroke-dasharray="4 3"></rect><text x="46" y="364.8" font-size="12" font-weight="bold" fill="#92400e">Invariants — enforced by root: Promotion</text><rect x="47" y="376" width="6" height="6" transform="rotate(45 50 379)" fill="#f59e0b"></rect><text x="62" y="382" font-size="12" fill="#78350f">A promo code is unique and case-insensitive across all currently active promotions</text><rect x="47" y="401" width="6" height="6" transform="rotate(45 50 404)" fill="#f59e0b"></rect><text x="62" y="407" font-size="12" fill="#78350f">Redemption count never exceeds the redemption budget — the promotion deactivates itself on reaching</text><text x="62" y="423" font-size="12" fill="#78350f">it</text><rect x="47" y="442" width="6" height="6" transform="rotate(45 50 445)" fill="#f59e0b"></rect><text x="62" y="448" font-size="12" fill="#78350f">A promotion applies only when every one of its conditions is satisfied by the cart at checkout time</text><rect x="47" y="467" width="6" height="6" transform="rotate(45 50 470)" fill="#f59e0b"></rect><text x="62" y="473" font-size="12" fill="#78350f">Stacking — At most one promotion applies per order unless the promotion is explicitly marked</text><text x="62" y="489" font-size="12" fill="#78350f">stackable</text></g><g class="d5-legend"><rect x="30" y="561" width="14" height="14" rx="3" fill="white" stroke="#3b82f6" stroke-width="3"></rect><text x="50" y="572" font-size="11" fill="#64748b">Aggregate Root</text><rect x="156.43000000000004" y="561" width="14" height="14" rx="3" fill="white" stroke="#3b82f6" stroke-width="2"></rect><text x="176.43000000000004" y="572" font-size="11" fill="#64748b">Entity</text><rect x="234.35000000000002" y="561" width="14" height="14" rx="7" fill="white" stroke="#10b981" stroke-width="2"></rect><text x="254.35000000000002" y="572" font-size="11" fill="#64748b">Value Object</text></g>"`;

exports[`examples render regression > nick-tune-core-domain-chart/context-pricing.md > matches SVG snapshot 1`] = `"<defs><marker id="d5-arrowhead" markerWidth="8" markerHeight="8" refX="8" refY="4" orient="auto"><path d="M0,0 L8,4 L0,8" fill="#64748b"></path></marker><marker id="d5-event-arrowhead" markerWidth="8" markerHeight="8" refX="8" refY="4" orient="auto"><path d="M0,0 L8,4 L0,8" fill="#d97706"></path></marker><marker id="d5-policy-arrowhead" markerWidth="8" markerHeight="8" refX="8" refY="4" orient="auto"><path d="M0,0 L8,4 L0,8" fill="#7c3aed"></path></marker></defs><text class="d5-title" x="744" y="24" text-anchor="middle" font-size="18" font-weight="bold" fill="#1e293b">Pricing Context — Tactical Structure</text><g class="d5-bounded-context"><rect x="30" y="64" width="1428" height="504" rx="12" fill="#f8fafc" stroke="#94a3b8" stroke-width="2" stroke-dasharray="8 4"></rect><text x="46" y="88" font-size="14" font-weight="600" fill="#475569">Pricing</text><text x="1442" y="88" font-size="12" font-style="italic" fill="#64748b" text-anchor="end">Team: Pricing Team</text></g><g class="d5-language-note"><rect x="1100" y="130" width="328" height="408" rx="4" fill="#fef9c3" stroke="#ca8a04" stroke-width="1.5"></rect><path d="M1100,160 L1100,134 Q1100,130 1104,130 L1424,130 Q1428,130 1428,134 L1428,160 Z" fill="#fde047"></path><text x="1264" y="150" text-anchor="middle" font-size="12" font-weight="bold" fill="#854d0e">Ubiquitous Language</text><text x="1114" y="184.2" font-size="12" font-weight="bold" fill="#713f12">Price Rule:</text><text x="1114" y="202.2" font-size="11" fill="#854d0e">A prioritised rule that computes a base price for a scope</text><text x="1114" y="216.2" font-size="11" fill="#854d0e">of products — a category, a brand or a single SKU</text><text x="1114" y="242.2" font-size="12" font-weight="bold" fill="#713f12">Effective Price:</text><text x="1114" y="260.2" font-size="11" fill="#854d0e">The price a shopper actually sees: the winning base price</text><text x="1114" y="274.2" font-size="11" fill="#854d0e">rule for the SKU with any applicable promotion applied</text><text x="1114" y="300.2" font-size="12" font-weight="bold" fill="#713f12">Promotion:</text><text x="1114" y="318.2" font-size="11" fill="#854d0e">A time-boxed discount identified by a code, applied on top</text><text x="1114" y="332.2" font-size="11" fill="#854d0e">of the base price when its conditions are met, capped by a</text><text x="1114" y="346.2" font-size="11" fill="#854d0e">redemption budget</text><text x="1114" y="372.2" font-size="12" font-weight="bold" fill="#713f12">Markdown:</text><text x="1114" y="390.2" font-size="11" fill="#854d0e">A price rule that lowers price as stock ages or</text><text x="1114" y="404.2" font-size="11" fill="#854d0e">availability rises — reads live inventory levels</text><text x="1114" y="430.2" font-size="12" font-weight="bold" fill="#713f12">Redemption Budget:</text><text x="1114" y="448.2" font-size="11" fill="#854d0e">The maximum number of times a promotion may be</text><text x="1114" y="462.2" font-size="11" fill="#854d0e">applied before it self-deactivates</text><text x="1114" y="488.2" font-size="12" font-weight="bold" fill="#713f12">Rule Priority:</text><text x="1114" y="506.2" font-size="11" fill="#854d0e">Higher-priority rules win; ties are broken by the most</text><text x="1114" y="520.2" font-size="11" fill="#854d0e">specific scope (SKU over brand over category)</text></g><g class="d5-aggregate"><rect x="452" y="249.5" width="180" height="166" rx="8" fill="white" stroke="#3b82f6" stroke-width="2"></rect><path d="M452,283.5 L452,257.5 Q452,249.5 460,249.5 L624,249.5 Q632,249.5 632,257.5 L632,283.5 Z" fill="#dbeafe"></path><line x1="452" y1="283.5" x2="632" y2="283.5" stroke="#3b82f6" stroke-width="1.5"></line><text x="542" y="269.5" text-anchor="middle" font-size="13" font-weight="bold" fill="#1e293b">Price Rule</text><text x="542" y="303.5" text-anchor="middle" font-size="11" font-style="italic" fill="#3b82f6">Root: Price Rule</text><line x1="462" y1="315.5" x2="622" y2="315.5" stroke="#cbd5e1" stroke-dasharray="4 4"></line><circle cx="472" cy="329.5" r="3" fill="#94a3b8"></circle><text x="482" y="333.5" font-size="12" fill="#475569">Scope</text><circle cx="472" cy="349.5" r="3" fill="#94a3b8"></circle><text x="482" y="353.5" font-size="12" fill="#475569">Formula</text><circle cx="472" cy="369.5" r="3" fill="#94a3b8"></circle><text x="482" y="373.5" font-size="12" fill="#475569">Priority</text><circle cx="472" cy="389.5" r="3" fill="#94a3b8"></circle><text x="482" y="393.5" font-size="12" fill="#475569">Active Window</text></g><g class="d5-aggregate"><rect x="60" y="173" width="180" height="186" rx="8" fill="white" stroke="#3b82f6" stroke-width="2"></rect><path d="M60,207 L60,181 Q60,173 68,173 L232,173 Q240,173 240,181 L240,207 Z" fill="#dbeafe"></path><line x1="60" y1="207" x2="240" y2="207" stroke="#3b82f6" stroke-width="1.5"></line><text x="150" y="193" text-anchor="middle" font-size="13" font-weight="bold" fill="#1e293b">Promotion</text><text x="150" y="227" text-anchor="middle" font-size="11" font-style="italic" fill="#3b82f6">Root: Promotion</text><line x1="70" y1="239" x2="230" y2="239" stroke="#cbd5e1" stroke-dasharray="4 4"></line><circle cx="80" cy="253" r="3" fill="#94a3b8"></circle><text x="90" y="257" font-size="12" fill="#475569">Code</text><circle cx="80" cy="273" r="3" fill="#94a3b8"></circle><text x="90" y="277" font-size="12" fill="#475569">Discount</text><circle cx="80" cy="293" r="3" fill="#94a3b8"></circle><text x="90" y="297" font-size="12" fill="#475569">Conditions</text><circle cx="80" cy="313" r="3" fill="#94a3b8"></circle><text x="90" y="317" font-size="12" fill="#475569">Redemption Budget</text><circle cx="80" cy="333" r="3" fill="#94a3b8"></circle><text x="90" y="337" font-size="12" fill="#475569">Redemptions</text></g><g class="d5-read-model"><rect x="860" y="229" width="180" height="74" rx="6" fill="white" stroke="#64748b" stroke-width="2"></rect><path d="M860,259 L860,235 Q860,229 866,229 L1034,229 Q1040,229 1040,235 L1040,259 Z" fill="#f1f5f9"></path><line x1="860" y1="259" x2="1040" y2="259" stroke="#64748b" stroke-width="1"></line><text x="950" y="248" text-anchor="middle" font-size="13" font-weight="bold" fill="#1e293b">Effective Price Book</text><text x="950" y="275" text-anchor="middle" font-size="10" font-style="italic" fill="#64748b">read model</text><line x1="872" y1="289" x2="1028" y2="289" stroke="#e2e8f0" stroke-width="1"></line><line x1="872" y1="298" x2="1028" y2="298" stroke="#e2e8f0" stroke-width="1"></line></g><g class="d5-rel"><path d="M 240 296.5357142857143 Q 346 332.5 399 332.5 L 452 332.5" fill="none" stroke="#64748b" stroke-width="1.5" marker-end="url(#d5-arrowhead)"></path><g class="d5-edge-label"><rect x="270" y="310" width="152" height="45" rx="4" fill="white" fill-opacity="0.92" stroke="#cbd5e1" stroke-width="1"></rect><text x="346" y="321.2" text-anchor="middle" font-size="10" font-weight="600" fill="#475569">a promotion layers on top of</text><text x="346" y="334.2" text-anchor="middle" font-size="10" font-weight="600" fill="#475569">the winning base price rule</text><text x="346" y="347.2" text-anchor="middle" font-size="10" font-weight="600" fill="#475569">for a scope</text></g></g><g class="d5-event"><title>PriceRuleChanged — emitted by price_rule_agg, handled by effective_price_book</title><path d="M 632 345.7352941176471 Q 746 362.5 808.8911917098446 332.75 L 871.7823834196892 303" fill="none" stroke="#d97706" stroke-width="1.5" stroke-dasharray="6 4" marker-end="url(#d5-event-arrowhead)"></path><g class="d5-event-label"><path d="M689.5,353.5 L795.5,353.5 L802.5,362.5 L795.5,371.5 L689.5,371.5 Z" fill="#fef3c7" stroke="#d97706" stroke-width="1"></path><text x="742.5" y="366" text-anchor="middle" font-size="10" font-weight="600" fill="#92400e">PriceRuleChanged</text></g></g><g class="d5-event"><title>PromotionActivated — emitted by promotion_agg, handled by effective_price_book</title><path d="M 240 235.46428571428572 Q 346 199.5 444 199.5 Q 542 199.5 644 199.5 Q 746 199.5 803 218.08088235294116 L 860 236.66176470588235" fill="none" stroke="#d97706" stroke-width="1.5" stroke-dasharray="6 4" marker-end="url(#d5-event-arrowhead)"></path><g class="d5-event-label"><path d="M482,190.5 L595,190.5 L602,199.5 L595,208.5 L482,208.5 Z" fill="#fef3c7" stroke="#d97706" stroke-width="1"></path><text x="538.5" y="203" text-anchor="middle" font-size="10" font-weight="600" fill="#92400e">PromotionActivated</text></g></g><g class="d5-policy"><title>Policy — triggered via promotion_agg, acts on promotion_agg</title><path d="M 90.07159904534606 359 Q 60 405.66666666666663 60 411.5 Q 60 417.33333333333337 105 423.1666666666667 Q 150 429 195 423.1666666666667 Q 240 417.33333333333337 240 411.5 Q 240 405.66666666666663 224.96420047732698 382.3333333333333 L 209.92840095465394 359" fill="none" stroke="#7c3aed" stroke-width="1.5" stroke-dasharray="3 3" marker-end="url(#d5-policy-arrowhead)"></path><g class="d5-policy-label"><rect x="84" y="399" width="132" height="60" rx="4" fill="#ede9fe" stroke="#7c3aed" stroke-width="1"></rect><text x="150" y="411.2" text-anchor="middle" font-size="10" font-weight="600" fill="#5b21b6">when a promotion's</text><text x="150" y="424.2" text-anchor="middle" font-size="10" font-weight="600" fill="#5b21b6">redemption budget is</text><text x="150" y="437.2" text-anchor="middle" font-size="10" font-weight="600" fill="#5b21b6">exhausted, deactivate it</text><text x="150" y="450.2" text-anchor="middle" font-size="10" font-weight="600" fill="#5b21b6">immediately</text></g></g><g class="d5-policy"><title>Policy — triggered via price_rule_agg, acts on effective_price_book</title><path d="M 632 314.19117647058823 Q 746 291 803 284.0147058823529 L 860 277.02941176470586" fill="none" stroke="#7c3aed" stroke-width="1.5" stroke-dasharray="3 3" marker-end="url(#d5-policy-arrowhead)"></path><g class="d5-policy-label"><rect x="662" y="261" width="168" height="60" rx="4" fill="#ede9fe" stroke="#7c3aed" stroke-width="1"></rect><text x="746" y="273.2" text-anchor="middle" font-size="10" font-weight="600" fill="#5b21b6">when any price rule or</text><text x="746" y="286.2" text-anchor="middle" font-size="10" font-weight="600" fill="#5b21b6">promotion changes, recompute</text><text x="746" y="299.2" text-anchor="middle" font-size="10" font-weight="600" fill="#5b21b6">the effective price for every</text><text x="746" y="312.2" text-anchor="middle" font-size="10" font-weight="600" fill="#5b21b6">affected SKU</text></g></g>"`;

