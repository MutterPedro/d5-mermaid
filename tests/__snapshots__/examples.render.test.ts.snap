exports[`examples render regression > wolff-microservices/aggregate-delivery.md > matches SVG snapshot 1`] = `"<text class="d5-title" x="469" y="24" text-anchor="middle" font-size="18" font-weight="bold" fill="#1e293b">Delivery Aggregate</text><g class="d5-aggregate"><rect x="30" y="70" width="878" height="443" rx="12" fill="#f8fafc" stroke="#94a3b8" stroke-width="2" stroke-dasharray="8 4"></rect><text x="46" y="94" font-size="14" font-weight="600" fill="#475569">Aggregate: Delivery</text></g><g class="d5-entity d5-aggregate-root"><rect x="58" y="134" width="822" height="58" rx="8" fill="#eff6ff" stroke="#3b82f6" stroke-width="3"></rect><text x="469" y="159" text-anchor="middle" font-size="15" font-weight="bold" fill="#1e293b">Delivery</text><text x="469" y="177" text-anchor="middle" font-size="10" font-style="italic" fill="#3b82f6">Aggregate Root</text></g><g class="d5-value-object"><rect x="58" y="216" width="150" height="49" rx="24.5" fill="white" stroke="#10b981" stroke-width="2"></rect><text x="133" y="236.05" text-anchor="middle" font-size="13" font-weight="600" fill="#1e293b">Delivery ID</text><text x="133" y="255.05" text-anchor="middle" font-size="10" font-style="italic" fill="#10b981">Value Object</text></g><g class="d5-value-object"><rect x="226" y="216" width="150" height="49" rx="24.5" fill="white" stroke="#10b981" stroke-width="2"></rect><text x="301" y="236.05" text-anchor="middle" font-size="13" font-weight="600" fill="#1e293b">Order ID</text><text x="301" y="255.05" text-anchor="middle" font-size="10" font-style="italic" fill="#10b981">Value Object</text></g><g class="d5-value-object"><rect x="394" y="216" width="150" height="49" rx="24.5" fill="white" stroke="#10b981" stroke-width="2"></rect><text x="469" y="236.05" text-anchor="middle" font-size="13" font-weight="600" fill="#1e293b">Delivery Address</text><text x="469" y="255.05" text-anchor="middle" font-size="10" font-style="italic" fill="#10b981">Value Object</text></g><g class="d5-value-object"><rect x="562" y="216" width="150" height="49" rx="24.5" fill="white" stroke="#10b981" stroke-width="2"></rect><text x="637" y="236.05" text-anchor="middle" font-size="13" font-weight="600" fill="#1e293b">Shipped Item</text><text x="637" y="255.05" text-anchor="middle" font-size="10" font-style="italic" fill="#10b981">Value Object</text></g><g class="d5-value-object"><rect x="730" y="216" width="150" height="49" rx="24.5" fill="white" stroke="#10b981" stroke-width="2"></rect><text x="805" y="236.05" text-anchor="middle" font-size="13" font-weight="600" fill="#1e293b">Delivery Status</text><text x="805" y="255.05" text-anchor="middle" font-size="10" font-style="italic" fill="#10b981">Value Object</text></g><g class="d5-value-object"><rect x="58" y="283" width="150" height="49" rx="24.5" fill="white" stroke="#10b981" stroke-width="2"></rect><text x="133" y="303.05" text-anchor="middle" font-size="13" font-weight="600" fill="#1e293b">Tracking Code</text><text x="133" y="322.05" text-anchor="middle" font-size="10" font-style="italic" fill="#10b981">Value Object</text></g><g class="d5-invariants"><rect x="38" y="342" width="862" height="143" rx="6" fill="#fffbeb" stroke="#fcd34d" stroke-width="1" stroke-dasharray="4 3"></rect><text x="46" y="364.8" font-size="12" font-weight="bold" fill="#92400e">Invariants — enforced by root: Delivery</text><rect x="47" y="376" width="6" height="6" transform="rotate(45 50 379)" fill="#f59e0b"></rect><text x="62" y="382" font-size="12" fill="#78350f">A delivery is created from exactly one placed order, referenced by order id</text><rect x="47" y="401" width="6" height="6" transform="rotate(45 50 404)" fill="#f59e0b"></rect><text x="62" y="407" font-size="12" fill="#78350f">The delivery address and the item list are copied from the order message at creation time</text><rect x="47" y="426" width="6" height="6" transform="rotate(45 50 429)" fill="#f59e0b"></rect><text x="62" y="432" font-size="12" fill="#78350f">A delivery is dispatched only once every ordered item is in stock at the warehouse</text><rect x="47" y="451" width="6" height="6" transform="rotate(45 50 454)" fill="#f59e0b"></rect><text x="62" y="457" font-size="12" fill="#78350f">Consuming the same OrderPlaced message twice does not produce a second delivery</text></g><g class="d5-legend"><rect x="30" y="529" width="14" height="14" rx="3" fill="white" stroke="#3b82f6" stroke-width="3"></rect><text x="50" y="540" font-size="11" fill="#64748b">Aggregate Root</text><rect x="156.43000000000004" y="529" width="14" height="14" rx="3" fill="white" stroke="#3b82f6" stroke-width="2"></rect><text x="176.43000000000004" y="540" font-size="11" fill="#64748b">Entity</text><rect x="234.35000000000002" y="529" width="14" height="14" rx="7" fill="white" stroke="#10b981" stroke-width="2"></rect><text x="254.35000000000002" y="540" font-size="11" fill="#64748b">Value Object</text></g>"`;

